@article{Paul:2012aa,
	annote = {10.1093/bioinformatics/bts314},
	author = {Paul, Joshua S. and Song, Yun S.},
	date = {2012/08/01},
	date-added = {2015-08-03 12:44:11 +0000},
	date-modified = {2015-08-03 12:48:47 +0000},
	doi = {10.1093/bioinformatics/bts314},
	journal = Bioinformatics,
	journal_long = {Bioinformatics},
	keywords = {hidden Markov model, inference, sequentially Markovian coalescent},
	m3 = {10.1093/bioinformatics/bts314},
	month = {08},
	number = {15},
	pages = {2008--2015},
	title = {Blockwise {HMM} computation for large-scale population genomic inference},
	ty = {JOUR},
	url = {http://bioinformatics.oxfordjournals.org/content/28/15/2008.abstract N2 - Motivation: A promising class of methods for large-scale population genomic inference use the conditional sampling distribution (CSD), which approximates the probability of sampling an individual with a particular DNA sequence, given that a collection of sequences from the population has already been observed. The CSD has a wide range of applications, including imputing missing sequence data, estimating recombination rates, inferring human colonization history and identifying tracts of distinct ancestry in admixed populations. Most well-used CSDs are based on hidden Markov models (HMMs). Although computationally efficient in principle, methods resulting from the common implementation of the relevant HMM techniques remain intractable for large genomic datasets.Results: To address this issue, a set of algorithmic improvements for performing the exact HMM computation is introduced here, by exploiting the particular structure of the CSD and typical characteristics of genomic data. It is empirically demonstrated that these improvements result in a speedup of several orders of magnitude for large datasets and that the speedup continues to increase with the number of sequences. The optimized algorithms can be adopted in methods for various applications, including the ones mentioned above and make previously impracticable analyses possible.Availability: Software available upon request.Supplementary Information: Supplementary data are available at Bioinformatics online.Contact: yss@eecs.berkeley.edu},
	volume = {28},
	year = {2012},
	bdsk-url-1 = {http://bioinformatics.oxfordjournals.org/content/28/15/2008.abstract%20N2%20-%20Motivation:%20A%20promising%20class%20of%20methods%20for%20large-scale%20population%20genomic%20inference%20use%20the%20conditional%20sampling%20distribution%20(CSD),%20which%20approximates%20the%20probability%20of%20sampling%20an%20individual%20with%20a%20particular%20DNA%20sequence,%20given%20that%20a%20collection%20of%20sequences%20from%20the%20population%20has%20already%20been%20observed.%20The%20CSD%20has%20a%20wide%20range%20of%20applications,%20including%20imputing%20missing%20sequence%20data,%20estimating%20recombination%20rates,%20inferring%20human%20colonization%20history%20and%20identifying%20tracts%20of%20distinct%20ancestry%20in%20admixed%20populations.%20Most%20well-used%20CSDs%20are%20based%20on%20hidden%20Markov%20models%20(HMMs).%20Although%20computationally%20efficient%20in%20principle,%20methods%20resulting%20from%20the%20common%20implementation%20of%20the%20relevant%20HMM%20techniques%20remain%20intractable%20for%20large%20genomic%20datasets.Results:%20To%20address%20this%20issue,%20a%20set%20of%20algorithmic%20improvements%20for%20performing%20the%20exact%20HMM%20computation%20is%20introduced%20here,%20by%20exploiting%20the%20particular%20structure%20of%20the%20CSD%20and%20typical%20characteristics%20of%20genomic%20data.%20It%20is%20empirically%20demonstrated%20that%20these%20improvements%20result%20in%20a%20speedup%20of%20several%20orders%20of%20magnitude%20for%20large%20datasets%20and%20that%20the%20speedup%20continues%20to%20increase%20with%20the%20number%20of%20sequences.%20The%20optimized%20algorithms%20can%20be%20adopted%20in%20methods%20for%20various%20applications,%20including%20the%20ones%20mentioned%20above%20and%20make%20previously%20impracticable%20analyses%20possible.Availability:%20Software%20available%20upon%20request.Supplementary%20Information:%20Supplementary%20data%20are%20available%20at%20Bioinformatics%20online.Contact:%20yss@eecs.berkeley.edu},
	bdsk-url-2 = {http://dx.doi.org/10.1093/bioinformatics/bts314}}

