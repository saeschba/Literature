	keywords = {Panthera tigris; admixture; captive tigers; inbreeding},
	mesh = {Tigers; Animals; United States; Genetic Variation; Endangered Species; Phylogeny; Conservation of Natural Resources; Genomics; Genome; Animals, Zoo},
	month = {Sep},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {39},
	pages = {e2402924121},
	pmc = {PMC11441546},
	pmid = {39298482},
	pst = {ppublish},
	title = {Unraveling the genomic diversity and admixture history of captive tigers in the United States},
	url = {https://doi.org/10.1073/pnas.2402924121},
