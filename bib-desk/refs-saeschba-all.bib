@article{Nicolaisen:2013aa,
	abstract = {Purifying selection at many linked sites alters patterns of molecular evolution, reducing overall diversity and distorting the shapes of genealogies. Recombination attenuates these effects; however, purifying selection can significantly distort genealogies even for substantial recombination rates. Here, we show that when selection and/or recombination are sufficiently strong, the genealogy at any single site can be described by a time-dependent effective population size, Ne(t), which has a simple analytic form. Our results illustrate how recombination reduces distortions in genealogies and allow us to quantitatively describe the shapes of genealogies in the presence of strong purifying selection and recombination. We also analyze the effects of a distribution of selection coefficients across the genome.},
	author = {Nicolaisen, Lauren E. and Desai, Michael M.},
	date-added = {2017-05-16 14:24:58 +0000},
	date-modified = {2017-05-16 14:26:42 +0000},
	doi = {10.1534/genetics.113.152983},
	eprint = {http://www.genetics.org/content/195/1/221.full.pdf},
	issn = {0016-6731},
	journal = Genetics,
	journal_long = {Genetics},
	keywords = {purifying selection, background selection, recombination, genealogies},
	number = {1},
	pages = {221--230},
	publisher = {Genetics},
	title = {Distortions in Genealogies due to Purifying Selection and Recombination},
	url = {http://www.genetics.org/content/195/1/221},
	volume = {195},
	year = {2013},
	bdsk-url-1 = {http://www.genetics.org/content/195/1/221},
	bdsk-url-2 = {http://dx.doi.org/10.1534/genetics.113.152983}}

@article{Walczak:2012aa,
	abstract = {Compared to a neutral model, purifying selection distorts the structure of genealogies and hence alters the patterns of sampled genetic variation. Although these distortions may be common in nature, our understanding of how we expect purifying selection to affect patterns of molecular variation remains incomplete. Genealogical approaches such as coalescent theory have proven difficult to generalize to situations involving selection at many linked sites, unless selection pressures are extremely strong. Here, we introduce an effective coalescent theory (a ``fitness-class coalescent'') to describe the structure of genealogies in the presence of purifying selection at many linked sites. We use this effective theory to calculate several simple statistics describing the expected patterns of variation in sequence data, both at the sites under selection and at linked neutral sites. Our analysis combines a description of the allele frequency spectrum in the presence of purifying selection with the structured coalescent approach of Kaplan et al. (1988), to trace the ancestry of individuals through the distribution of fitnesses within the population. We also derive our results using a more direct extension of the structured coalescent approach of Hudson and Kaplan (1994). We find that purifying selection leads to patterns of genetic variation that are related but not identical to a neutrally evolving population in which population size has varied in a specific way in the past.},
	author = {Walczak, Aleksandra M. and Nicolaisen, Lauren E. and Plotkin, Joshua B. and Desai, Michael M.},
	date = {2012/02/16},
	date-added = {2017-05-16 14:18:52 +0000},
	date-modified = {2017-05-16 14:24:20 +0000},
	journal = Genetics,
	journal1 = {Genetics},
	journal_long = {Genetics},
	keywords = {background selection, purifying selection, fitness-class coalescent},
	lp = {779},
	m3 = {10.1534/genetics.111.134544},
	month = {02},
	n2 = {Compared to a neutral model, purifying selection distorts the structure of genealogies and hence alters the patterns of sampled genetic variation. Although these distortions may be common in nature, our understanding of how we expect purifying selection to affect patterns of molecular variation remains incomplete. Genealogical approaches such as coalescent theory have proven difficult to generalize to situations involving selection at many linked sites, unless selection pressures are extremely strong. Here, we introduce an effective coalescent theory (a ``fitness-class coalescent'') to describe the structure of genealogies in the presence of purifying selection at many linked sites. We use this effective theory to calculate several simple statistics describing the expected patterns of variation in sequence data, both at the sites under selection and at linked neutral sites. Our analysis combines a description of the allele frequency spectrum in the presence of purifying selection with the structured coalescent approach of Kaplan et al. (1988), to trace the ancestry of individuals through the distribution of fitnesses within the population. We also derive our results using a more direct extension of the structured coalescent approach of Hudson and Kaplan (1994). We find that purifying selection leads to patterns of genetic variation that are related but not identical to a neutrally evolving population in which population size has varied in a specific way in the past.},
	number = {2},
	pages = {753},
	title = {The Structure of Genealogies in the Presence of Purifying Selection: A Fitness-Class Coalescent},
	ty = {JOUR},
