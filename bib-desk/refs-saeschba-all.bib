	keywords = {isolation, migration, variance of pairwise differences, statistical test, mtDNA},
	number = {3},
	pages = {369 - 386},
	title = {Distinguishing Migration from Isolation Using the Variance of Pairwise Differences},
	url = {http://www.sciencedirect.com/science/article/pii/S0040580996900180},
