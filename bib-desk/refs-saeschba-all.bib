	keywords = {Gaussian processes; Interpolation},
	m3 = {Article},
	month = {09},
	number = {3},
	publisher = {Blackwell Publishing Limited},
	sp = {425},
	title = {Bayesian calibration of computer models},
	ty = {JOUR},
