	affiliation = {Jenkins, PA (Reprint Author), Univ Calif Berkeley, Dept Comp Sci, Berkeley, CA 94720 USA.. Jenkins, Paul A., Univ Calif Berkeley, Dept Comp Sci, Berkeley, CA 94720 USA. Song, Yun S., Univ Calif Berkeley, Dept Stat, Berkeley, CA 94720 USA. Song, Yun S., Univ Calif Berkeley, Div Comp Sci, Berkeley, CA 94720 USA.},
