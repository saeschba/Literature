	pmc = {PMC6562021},
	pmid = {31155286},
	pst = {ppublish},
	title = {Geographic Variation and Bias in the Polygenic Scores of Complex Diseases and Traits in {F}inland},
	url = {https://doi.org/10.1016/j.ajhg.2019.05.001},
	volume = {104},
