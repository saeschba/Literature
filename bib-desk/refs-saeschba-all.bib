	journal_long = {Evolution},
	keywords = {survival probability, two-locus model, branching process, multi-type branching process, hitchhiking},
	m1 = {ArticleType: research-article / Full publication date: Sep., 1967 / Copyright {\copyright}1967 Society for the Study of Evolution},
