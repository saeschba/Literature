@article{Hopkins:2020aa,
	abstract = {Speciation is a fundamental process shaping biodiversity. However, existing empirical methods often cannot provide key genetic and functional details required to validate speciation theory. New gene modification technologies can verify the causal functionality of genes with astonishing accuracy, helping resolve questions about how reproductive isolation evolves during speciation.},
	author = {Hopkins, David P and Tyukmaeva, Venera I and Gompert, Zach and Feder, Jeff and Nosil, Patrik},
