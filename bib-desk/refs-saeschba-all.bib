	keywords = {Finland; Genes, Dominant; Genes, Recessive; Genetic Diseases, Inborn; Genetic Markers; Genetics, Medical; Genetics, Population; Humans; Language; Linkage Disequilibrium; Models, Genetic, disease gene, gene mapping, genetic marker, recessive inheritance, common diseases},
	mesh = {Finland; Genes, Dominant; Genes, Recessive; Genetic Diseases, Inborn; Genetic Markers; Genetics, Medical; Genetics, Population; Humans; Language; Linkage Disequilibrium; Models, Genetic},
	pages = {103--128},
	pmid = {11701645},
