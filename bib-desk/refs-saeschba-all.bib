	journal = {SIAM Review},
	journal_long = {SIAM Review},
	keywords = {birth--death process, branching process, immigration, progeny generating function, ma- trix exponential, Poisson process, Kronecker product, mutation, X-linked, haplotype, vaccination, HIV},
	number = {2},
	pages = {202-229},
