@article{Reinhardt:2014aa,
	abstract = {Drosophila melanogaster, an ancestrally African species, has recently spread throughout the world, associated with human activity. The species has served as the focus of many studies investigating local adaptation relating to latitudinal variation in non-African populations, especially those from the United States and Australia. These studies have documented the existence of shared, genetically determined phenotypic clines for several life history and morphological traits. However, there are no studies designed to formally address the degree of shared latitudinal differentiation at the genomic level. Here we present our comparative analysis of such differentiation. Not surprisingly, we find evidence of substantial, shared selection responses on the two continents, probably resulting from selection on standing ancestral variation. The polymorphic inversion In(3R)P has an important effect on this pattern, but considerable parallelism is also observed across the genome in regions not associated with inversion polymorphism. Interestingly, parallel latitudinal differentiation is observed even for variants that are not particularly strongly differentiated, which suggests that very large numbers of polymorphisms are targets of spatially varying selection in this species.},
	author = {Reinhardt, Josie A. and Kolaczkowski, Bryan and Jones, Corbin D. and Begun, David J. and Kern, Andrew D.},
	date = {2014/05/07},
	date-added = {2017-09-22 12:50:30 +0000},
	date-modified = {2017-09-22 12:51:21 +0000},
	journal = Genetics,
	journal1 = {Genetics},
	journal_long = {Genetics},
	keywords = {Drosophila melanogaster, geographic variation, parallel evolution},
	lp = {373},
	m3 = {10.1534/genetics.114.161463},
	month = {05},
	n2 = {Drosophila melanogaster, an ancestrally African species, has recently spread throughout the world, associated with human activity. The species has served as the focus of many studies investigating local adaptation relating to latitudinal variation in non-African populations, especially those from the United States and Australia. These studies have documented the existence of shared, genetically determined phenotypic clines for several life history and morphological traits. However, there are no studies designed to formally address the degree of shared latitudinal differentiation at the genomic level. Here we present our comparative analysis of such differentiation. Not surprisingly, we find evidence of substantial, shared selection responses on the two continents, probably resulting from selection on standing ancestral variation. The polymorphic inversion In(3R)P has an important effect on this pattern, but considerable parallelism is also observed across the genome in regions not associated with inversion polymorphism. Interestingly, parallel latitudinal differentiation is observed even for variants that are not particularly strongly differentiated, which suggests that very large numbers of polymorphisms are targets of spatially varying selection in this species.},
	number = {1},
	pages = {361},
	title = {Parallel Geographic Variation in \emph{{Drosophila melanogaster}}},
	ty = {JOUR},
	url = {http://www.genetics.org/content/197/1/361.abstract},
	volume = {197},
	year = {2014},
	bdsk-url-1 = {http://www.genetics.org/content/197/1/361.abstract}}

@article{Fiston-Lavier:2010aa,
	abstract = {Recombination rate is a key evolutionary parameter that determines the degree to which sites are linked. Estimating recombination rates is thus of crucial importance for population genetic and molecular evolutionary studies. We present here a user-friendly web-based tool that can be used to retrieve recombination rate estimates for single and/or multiple loci in the Drosophila melanogaster genome given a user-defined choice of the genome release. We used the Marey map approach that is based on comparing the genetic and physical maps to infer recombination rates along the major chromosomes of the D. melanogaster genome. Our implementation of this approach is based on building third-order polynomials which are used to interpolate recombination rates at all points on the chromosome except for telomeric and centromeric regions in which such polynomials are known to provide particularly poor estimation. },
	author = {Anna-Sophie Fiston-Lavier and Nadia D. Singh and Mikhail Lipatov and Dmitri A. Petrov},
	date-added = {2017-09-22 08:23:35 +0000},
	date-modified = {2017-10-15 19:08:57 +0000},
	doi = {https://doi.org/10.1016/j.gene.2010.04.015},
	issn = {0378-1119},
	journal = Gene,
	journal_long = {Gene},
	keywords = {Drosophila, recombination rate},
	number = {1--2},
	pages = {18--20},
	title = {\emph{{Drosophila melanogaster}} recombination rate calculator},
	url = {http://www.sciencedirect.com/science/article/pii/S0378111910001769},
	volume = {463},
	year = {2010},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0378111910001769},
	bdsk-url-2 = {https://doi.org/10.1016/j.gene.2010.04.015}}

@article{Aflitos:2014aa,
	abstract = {We explored genetic variation by sequencing a selection of 84 tomato accessions and related wild species representative of the Lycopersicon, Arcanum, Eriopersicon and Neolycopersicon groups, which has yielded a huge amount of precious data on sequence diversity in the tomato clade. Three new reference genomes were reconstructed to support our comparative genome analyses. Comparative sequence alignment revealed group-, species- and accession-specific polymorphisms, explaining characteristic fruit traits and growth habits in the various cultivars. Using gene models from the annotated Heinz 1706 reference genome, we observed differences in the ratio between non-synonymous and synonymous SNPs (dN/dS) in fruit diversification and plant growth genes compared to a random set of genes, indicating positive selection and differences in selection pressure between crop accessions and wild species. In wild species, the number of single-nucleotide polymorphisms (SNPs) exceeds 10 million, i.e. 20-fold higher than found in most of the crop accessions, indicating dramatic genetic erosion of crop and heirloom tomatoes. In addition, the highest levels of heterozygosity were found for allogamous self-incompatible wild species, while facultative and autogamous self-compatible species display a lower heterozygosity level. Using whole-genome SNP information for maximum-likelihood analysis, we achieved complete tree resolution, whereas maximum-likelihood trees based on SNPs from ten fruit and growth genes show incomplete resolution for the crop accessions, partly due to the effect of heterozygous SNPs. Finally, results suggest that phylogenetic relationships are correlated with habitat, indicating the occurrence of geographical races within these groups, which is of practical importance for Solanum genome evolution studies.},
	author = {Aflitos, Saulo and Schijlen, Elio and de Jong, Hans and de Ridder, Dick and Smit, Sandra and Finkers, Richard and Wang, Jun and Zhang, Gengyun and Li, Ning and Mao, Likai and Bakker, Freek and Dirks, Rob and Breit, Timo and Gravendeel, Barbara and Huits, Henk and Struss, Darush and Swanson-Wagner, Ruth and van Leeuwen, Hans and van Ham, Roeland C. H. J. and Fito, Laia and Guignier, La{\"e}titia and Sevilla, Myrna and Ellul, Philippe and Ganko, Eric and Kapur, Arvind and Reclus, Emannuel and de Geus, Bernard and van de Geest, Henri and te Lintel Hekkert, Bas and van Haarst, Jan and Smits, Lars and Koops, Andries and Sanchez-Perez, Gabino and van Heusden, Adriaan W. and Visser, Richard and Quan, Zhiwu and Min, Jiumeng and Liao, Li and Wang, Xiaoli and Wang, Guangbiao and Yue, Zhen and Yang, Xinhua and Xu, Na and Schranz, Eric and Smets, Erik and Vos, Rutger and Rauwerda, Johan and Ursem, Remco and Schuit, Cees and Kerns, Mike and van den Berg, Jan and Vriezen, Wim and Janssen, Antoine and Datema, Erwin and Jahrman, Torben and Moquet, Frederic and Bonnet, Julien and Peters, Sander},
	date-added = {2017-09-20 09:51:01 +0000},
	date-modified = {2017-10-01 17:55:47 +0000},
	doi = {10.1111/tpj.12616},
	isbn = {1365-313X},
	journal = PlantJ,
	journal1 = {Plant J},
	journal_long = {The Plant Journal},
	keywords = {Solanum genetic diversity; comparative sequence analysis; phylogenomics; introgression; chromosome evolution; Solanum lycopersicum; Solanum pennellii; Solanum arcanum; Solanum habrochaites; heterozygosity},
	number = {1},
	pages = {136--148},
	title = {Exploring genetic variation in the tomato (\emph{{Solanum}} section \emph{{Lycopersicon}}) clade by whole-genome sequencing},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1111/tpj.12616},
	volume = {80},
	year = {2014},
	bdsk-url-1 = {http://dx.doi.org/10.1111/tpj.12616}}

