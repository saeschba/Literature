	journal = TrendsEcolEvol,
	journal-full = {Trends in ecology \& evolution},
	journal_long = {Trends in Ecology and Evolution},
	keywords = {genetic drift; genetic rescue; inbreeding; mutation; purging},
	mesh = {Animals; Consanguinity; Inbreeding Depression; Mutation},
	month = {Dec},
	number = {12},
