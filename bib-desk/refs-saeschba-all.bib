	keywords = {Phytophthora infestans, mating type},
	mesh = {DNA, Mitochondrial; Fungicides, Industrial; Genes, Mating Type, Fungal; Genotype; High-Throughput Nucleotide Sequencing; Lycopersicon esculentum; Microsatellite Repeats; Phytophthora infestans; Plant Diseases; Sequence Analysis, DNA; Solanum tuberosum},
