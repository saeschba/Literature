@article{Karlin:1968fk,
	abstract = {This paper considers a *neutral* two-locus model of random genetic drift. The authors' hope was that this will help future treatment of the stochastic model with selection.

Assuming the random union of gametes model (RUG), the corresponding Markov chain is formulated (state space and transition probabilities). A complete analysis is too complex, but the following results are derived:

I) Probabilities of fixation in the four absorbing states

II) Rate of approach to fixation

III) Conditional on fixation and the initial state, the probability of fixation in a particular state

IV) Rate of loss of a particular gene from the population},
	annote = {Contains a summary of the work in the 1950s and 60s on two-locus models, a critical review of Monte Carlo approaches (dependence on initial conditions, parameters, numerical issues) and, derived from this, an argument of an analytical treatment of the stochastic model.},
