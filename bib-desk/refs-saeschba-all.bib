@article{Ewens:1968fk,
	annote = {Multiple-type branching processes are used in this paper to derive survival probabilities of mutant genes in a number of situations in population genetics. Specifically, we apply the theory in the following cases. (1) Bisexual populations. In a population allowing (say) far more males than females, a favourable new mutation will have far greater survival probability if it occurs initially in a female; use of weighted survival probabilities will allow derivation of an optimum sex ratio. (2) Two locus problems. The selective advantage of a gene is not a fixed quantity but depends on the "genetic background", that is on the genes present at other loci in the individual in question. Here we suppose that the selective advantage depends, in this way, only on a second interacting locus. Attention will be concentrated on the effect of linkage between the two loci. (3) The extension to three locus problems. (4) In a model introduced by Kimura (1957) it is assumed that a chromosome consists of a number k of sub-units, or strands, in any one of which a mutation may occur. The mode of inheritance is such that each strand duplicates itself and the daughter chromosome is made up of a random collection of k of the 2k strands so obtained. This model allows a wide field of possible investigations, only a few of which are considered here. Apart from questions of genetical interest, it is shown that a multiple-type branching process may not possess the close relationship with the corresponding deterministic process that is enjoyed by a single-type process. This means that some caution may be needed in drawing conclusions about the stochastic behaviour from the deterministic behaviour.},
	author = {Ewens, W. J.},
	cr = {Copyright \copyright 1968 Royal Statistical Society},
	date = {1968/01/01},
	date-added = {2011-12-05 07:17:00 +0000},
	date-modified = {2011-12-05 07:19:14 +0000},
	isbn = {00359246},
	journal = JRStatSocB,
	journal_long = {Journal of the Royal Statistical Society. Series B (Methodological)},
	keywords = {recombination, sex ratio, chromosome division, linkage, multi-type branching process, survival probability},
	m1 = {ArticleType: research-article / Full publication date: 1968 / Copyright {\copyright}1968 Royal Statistical Society},
	month = {01},
	number = {1},
	pages = {164--175},
	publisher = {Blackwell Publishing for the Royal Statistical Society},
	title = {Some Applications of Multiple-Type Branching Processes in Population Genetics},
	ty = {JOUR},
	url = {http://www.jstor.org/stable/2984467},
	volume = {30},
	year = {1968},
	bdsk-url-1 = {http://www.jstor.org/stable/2984467}}

@article{Ewens:1967fk,
	abstract = {The problem of the probability of survival of a new mutant is considered in a two-locus setting. If the genes at the two loci act "independently," the probability of survival is independent of the degree of linkage between the loci. If there is "interaction" between the gene effects, then contrary to the behavior to be expected from a deterministic treatment, there exist many situations where decreased linkage between the loci increases the probability of survival of the mutant. In many cases there appears to be an optimum intermediate value for the degree of linkage. An explicit formula is obtained which gives the condition for optimality of close linkage. Further, it is suggested that the process of fixation of a new mutant at one locus increases the probability of fixation of favorable new mutants at other loci, and the consequences of this possibility are discussed.},
	author = {Ewens, W. J.},
	copyright = {Copyright {\copyright} 1967 Society for the Study of Evolution},
