@article{Sinding:2018aa,
	abstract = {Author summary Full genome sequencing is becoming an increasingly valuable tool for both the management of animal populations, as well as fundamental to improving our understanding of their evolutionary history. The grey wolf (Canis lupus) is a keystone species in North America whose population structure and admixture has yet to be fully investigated in this way. We compiled a dataset of 40 full genomes spanning their total geographic range on the continent. In addition to confirming general population structure among them and previous reports of admixed origins for several wolf-like canid species, we identify three particularly interesting groups: two in Arctic Canada and one novel ``Polar wolf'' population on Ellesmere Island and Greenland. The particularly low genetic diversity of the Polar wolves suggests a small and isolated population. Overall we provide new information of relevance for the future management of wolves in Arctic Canada and Greenland.},
	author = {Sinding, Mikkel-Holger S. AND Gopalakrishan, Shyam AND Vieira, Filipe G. AND Samaniego Castruita, Jose A. AND Raundrup, Katrine AND Heide J{\o}rgensen, Mads Peter AND Meldgaard, Morten AND Petersen, Bent AND Sicheritz-Ponten, Thomas AND Mikkelsen, Johan Brus AND Marquard-Petersen, Ulf AND Dietz, Rune AND Sonne, Christian AND Dal{\'e}n, Love AND Bachmann, Lutz AND Wiig, {\O}ystein AND Hansen, Anders J. AND Gilbert, M. Thomas P.},
	date-added = {2018-11-18 22:19:47 +0100},
	date-modified = {2018-11-18 22:22:25 +0100},
	doi = {10.1371/journal.pgen.1007745},
	journal = PLoSGenet,
	journal_long = {PLoS Genetics},
	keywords = {wolfs, population genomics, North America},
	month = {11},
	number = {11},
	pages = {1--23},
	publisher = {Public Library of Science},
	title = {Population genomics of grey wolves and wolf-like canids in North America},
	url = {https://doi.org/10.1371/journal.pgen.1007745},
	volume = {14},
	year = {2018},
	bdsk-url-1 = {https://doi.org/10.1371/journal.pgen.1007745}}

