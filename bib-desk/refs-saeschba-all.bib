	doi = {10.1093/dnares/dsaa029},
	journal = DNARes,
	journal-full = {DNA research : an international journal for rapid publication of reports on genes and genomes},
	journal_long = {DNA Research},
	keywords = {RNA-Seq; gene annotation; long-read sequencing; whole-genome comparison; wild tomato},
	mesh = {Genes, Plant; Genome, Plant; Genomics; High-Throughput Nucleotide Sequencing; Lycopersicon esculentum; Sequence Analysis, DNA; Sequence Analysis, RNA; Solanum; Transcriptome},
	month = {Jan},
	number = {1},
	pmc = {PMC7934570},
	pmid = {33475141},
	pst = {ppublish},
	title = {\empn{De novo} genome assembly of two tomato ancestors, \emph{{Solanum pimpinellifolium}} and \emph{{Solanum lycopersicum}} var.\ \emph{{cerasiforme}}, by long-read sequencing},
	url = {https://doi.org/10.1093/dnares/dsaa029},
	volume = {28},
