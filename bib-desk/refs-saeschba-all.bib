	journal = TheorPopulBiol,
	journal_long = {Theoretical Population Biology},
	keywords = {Wright--Fisher model},
	number = {0},
	pages = {47-53},
	title = {The existence and abundance of ghost ancestors in biparental populations},
	url = {http://www.sciencedirect.com/science/article/pii/S0040580915000167},
	volume = {101},
	year = {2015},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0040580915000167},
