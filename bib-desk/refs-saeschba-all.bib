	doi = {10.1038/s41588-022-01189-7},
	journal = NatGenet,
	journal-full = {Nature genetics},
	journal_long = {Nature Geneticis},
	keywords = {plant breeding, plant genetic resources, yellow rust, wheat, wheat breeding},
	mesh = {Genomics; Plant Breeding; Plants; Triticum},
	month = {Oct},
	number = {10},
	pages = {1544--1552},
	pmid = {36195758},
	pst = {ppublish},
	title = {Genomics-informed prebreeding unlocks the diversity in genebanks for wheat improvement},
	url = {https://doi.org/10.1038/s41588-022-01189-7},
	volume = {54},
	year = {2022},
