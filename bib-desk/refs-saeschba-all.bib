@article{OConnor:2018aa,
	abstract = {In a recent commentary, Doubleday and Connell [1] propose that science communication is impaired by a suite of ailments that can be treated by discovery and use of a mystery ingredient, `Ingredient X'. The ailments in science communication listed include restrictions of the `Official Style' of the research article genre, deficiency in the time researchers allocate to creative and narrative writing, and misallocation of learning effort to the development of a `mechanical set of skills'. Sensationally, the authors go on to warn against confusing Ingredient X with sensationalism as a result of insufficient scholarship. In this response we seek to briefly dispel some populist misconceptions about research article writing that are perpetuated in the Doubleday and Connell commentary.},
	annote = {doi: 10.1016/j.tree.2018.08.009},
