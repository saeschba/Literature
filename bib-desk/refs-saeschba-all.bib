	isbn = {2406-6168},
	j2 = {ActaHortic.},
	journal = ActaHort,
	journal_long = {Acta Horticulturae},
	keywords = {supplemental lighting, photoperiod, greenhouse, photoperiod, crop production, Quebec},
	month = {06},
	number = {580},
	pages = {59--67},
	publisher = {International Society for Horticultural Science (ISHS), Leuven, Belgium},
	title = {Physiological response of greenhouse vegetable crops to supplemental lighthing},
	ty = {CONF},
