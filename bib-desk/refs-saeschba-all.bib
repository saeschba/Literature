	keywords = {epistasis; four-gamete test; homoplasy; linkage disequilibrium; recombination},
	mesh = {Models, Genetic; Recombination, Genetic; Mutation; Selection, Genetic; Genetic Linkage; Genetic Drift; Evolution, Molecular; Gene Transfer, Horizontal},
	month = {Nov},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {3},
	pages = {iyae145},
