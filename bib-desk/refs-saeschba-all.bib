	journal_long = {PLoS One},
	keywords = {HLA, Swiss, Switzerland, human evolution, genetic structure},
	number = {7},
	pages = {e41400},
	publisher = {Public Library of Science},
	title = {The Heterogeneous {HLA} Genetic Makeup of the Swiss Population},
	ty = {JOUR},
	u1 = {PONE-D-12-01163{$[$}PII{$]$}; 22848484{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC3405111/},
