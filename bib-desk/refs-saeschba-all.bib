	keywords = {Solanum, gametophytic self-incompatibility, Cullin1},
	number = {2},
	pages = {439--442},
	publisher = {Genetics},
	title = {The Role of a Pollen-Expressed {Cullin1} Protein in Gametophytic Self-Incompatibility in \emph{{Solanum}}},
