	journal_long = {Evolution},
	keywords = {Mimulus sect. Erythranthe, monkeyflowers, ecological adaptation, phylogenetics, ribosomal DNA, ITS, ETS, AFLP, hummingbird pollination, insect pollination},
	mesh = {Animals; Birds; DNA Primers; DNA, Ribosomal; Electrophoresis, Polyacrylamide Gel; Flowers; Geography; Likelihood Functions; Mimulus; North America; Phylogeny; Pollen; Polymorphism, Restriction Fragment Length; Sequence Analysis, DNA},
	month = {Jun},
	number = {6},
