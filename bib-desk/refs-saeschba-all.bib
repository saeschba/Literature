	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {yeast, Saccharomyces cerevisiae, recombination, transcription},
	mesh = {Base Sequence; Chromosome Mapping; DNA Damage; DNA Primers; Meiosis; Nucleic Acid Hybridization; Recombination, Genetic; Saccharomyces cerevisiae},
