	journal = PLoSComputBiol,
	journal1 = {PLOS Computational Biology},
	journal_long = {PLoS Computational Biology},
	keywords = {teaching, programming, education},
	m3 = {doi:10.1371/journal.pcbi.1006023},
	month = {04},
