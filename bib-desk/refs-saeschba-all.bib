@article{Pollak:1992ly,
	abstract = {Consider a positively regular, slightly supercritical branching process with K types. An approximation to the probability of survival of a line descended from a single individual of type i has recently been derived by Hoppe. If K is large, however, this approximation may not be easy to compute. A further approximation that is easily computable is given. The result is used to estimate probabilities of survival of an allele A that is originally present in one male or one female in a large, random mating, age-structured population. Both autosomal and sex-linked loci are considered. Another application of the approximation is also discussed.},
	annote = {Extends an approximation by Hoppe (1992) for the probability of survival in a multi-type branching process. The approximation provided here is better than the one by Hoppe if the number of types is large. This paper considers autosomal and sex-linked loci, and studies an age-structured population.},
