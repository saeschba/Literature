@article{Holland:2007vw,
	abstract = {Genetic architecture refers to the numbers and genome locations of genes that affect a trait, the magnitude of their effects, and the relative contributions of additive, dominant, and epistatic gene effects. Quantitative trait locus (QTL) mapping techniques are commonly used to investigate genetic architectures, but the scope of inferences drawn from QTL studies are often restricted by the limitations of the experimental designs. Recent advances in experimental and statistical procedures, including the simultaneous analysis of QTL that segregate in diverse germplasm, should improve genetic architecture studies. High-resolution QTL mapping methods are being developed that may define the specific DNA sequence variants underlying QTL. Studies of genetic architecture, combined with improved knowledge of the structure of plant populations, will impact our understanding of plant evolution and the design of crop improvement strategies.},
	author = {Holland, James B},
	date-added = {2022-01-19 21:40:44 +0100},
	date-modified = {2022-01-19 21:41:09 +0100},
	doi = {10.1016/j.pbi.2007.01.003},
	journal = CurrOpinPlantBiol,
	journal-full = {Current opinion in plant biology},
	journal_long = {Current Opinion in Plant Biology},
	keywords = {Base Sequence; Epistasis, Genetic; Hybrid Vigor; Plants; Quantitative Trait Loci; Quantitative Trait, Heritable},
	mesh = {Base Sequence; Epistasis, Genetic; Hybrid Vigor; Plants; Quantitative Trait Loci; Quantitative Trait, Heritable},
	month = {Apr},
	number = {2},
	pages = {156-61},
	pmid = {17291822},
	pst = {ppublish},
	title = {Genetic architecture of complex traits in plants},
	volume = {10},
	year = {2007},
	bdsk-url-1 = {https://doi.org/10.1016/j.pbi.2007.01.003}}

