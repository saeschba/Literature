	journal = PLoSGenet,
	journal-full = {PLoS genetics},
	journal_long = {PLoS Genetics},
	keywords = {hybrid seed incompatibility, Capsella, chromatin condensation, endosperm},
	month = {Feb},
	number = {2},
	pages = {e1009370},
	pmid = {33571184},
	pst = {aheadofprint},
	title = {Hybrid seed incompatibility in \emph{{Capsella}} is connected to chromatin condensation defects in the endosperm},
