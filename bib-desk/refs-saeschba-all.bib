Blumenfield, Tami and Beheim, Bret and Beckerman, Stephen and Atkinson, Quentin and Apicella, Coren and Alam, Nurul and Mulder, Monique Borgerhoff},
	date-added = {2023-06-05 12:37:19 +0200},
	date-modified = {2023-06-05 12:37:42 +0200},
	doi = {10.1073/pnas.2220124120},
