	chapter = {Art{\'\i}culos},
	date = {2018/05/04},
	date-added = {2022-03-25 16:43:46 +0100},
	date-modified = {2022-03-25 16:45:28 +0100},
	doi = {10.29312/remexca.v4i5.1173},
	journal = {RevMexCiencAgricolas},
	journal1 = {Remexca},
