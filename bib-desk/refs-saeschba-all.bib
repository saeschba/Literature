	pages = {405--408},
	title = {{A molecular approach to the study of genic heterozygosity in natural populations V. Further direct evidence of coadaptation in inversions of \emph{Drosophila}}},
	volume = {96},
	year = {1971}}

@article{Bulmer:1971sz,
	abstract = {1. A model is formulated to describe the behaviour of a metri character subject to selection for diferent optimal values in two populations.
2. If theta1 and theta 2 are the two optimal values and V the phenotypic variance, it is shown that a stable equilibrium will exist if (theta1 -- theta2)^2/V is greater than a critical value, C, which depends on the heritability of the character, the intensity of selection and the migration rate between the two populations.
3. It is suggested that this mechanism may play an important part in the maintenance of genetic variability in natural populations.},
