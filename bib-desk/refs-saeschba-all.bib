@article{Parsons:1963ly,
	abstract = {The effect of varying coupling and repulsion double heterozygote viabilities for polymorphisms for two linked loci is considered. It is shown for a system of viabilities corresponding to Mather's (1943) concept of balance that the greatest linkage disequilibria occur when the repulsion double heterozygote viability is high. It is argued that the analysis provides some theoretical justificiation for the likelihood of repulsion linkages in the balanced genotype subjected to stabilising selection. Under such circumstances, it is likely that natural selection will lead to the repulsion double heterozygote viability being greater than the coupling double heterozygote viability.},
