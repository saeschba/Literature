	journal_long = {Nature},
	keywords = {Human evolution, Neanderthals, ancient DNA, bones, recombination},
	l3 = {10.1038/nature13810; http://www.nature.com/nature/journal/v514/n7523/abs/nature13810.html#supplementary-information},
	m3 = {Article},
	month = {10},
