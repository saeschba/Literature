	isbn = {0092-8674},
	journal = Cell,
	journal_long = {Cell},
	keywords = {polyploidisation, genome duplication},
	month = {11},
	number = {3},
	pages = {452--462},
	title = {The Evolutionary Consequences of Polyploidy},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/pii/S0092867407013402},
