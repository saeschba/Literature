	doi = {10.1038/s41588-024-02029-6},
	journal = NatGenet,
	journal-full = {Nature genetics},
	journal_long = {Nature Genetics},
	keywords = {pangenome graphs, biodiversity genomics, representation bias},
	mesh = {Biodiversity; Genomics; Genome; Genetic Variation; Humans; Animals},
	month = {Jan},
	number = {1},
	pages = {13--26},
	pmid = {39779953},
	pst = {ppublish},
	title = {Pangenome graphs and their applications in biodiversity genomics},
