	title = {An enhanced linkage map of the sheep genome comprising more than 1000 loci},
	volume = {11},
	year = {2001}}

@article{Kemp:1995ys,
	abstract = {Summary A panel of 81 new polymorphic bovine microsatellite markers is described, together with further information on a previously reported group of 16 markers. The mean polymorphism information content of the 97 markers determined in 20 cattle was 0.66. Seventythree of these markers have been assigned to chromosomes by either linkage analysis or use of hybrid cell panels. Thirty-nine of the markers were polymorphic in sheep, and 32 were polymorphic in goat. This study identified a set of 18 robust markers that were polymorphic in all three species and that covered 14 bovine chromosomes. This provides a single group of markers, which would be suited to genetic distance analysis and parentage control in cattle, sheep and goat.},
