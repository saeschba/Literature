	doi = {10.1073/pnas.2316827121},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {animal movement; ecological niche; life history; migration},
	mesh = {Animals; Seasons; Animal Migration; Birds; Ecosystem},
	month = {Oct},
	monthly-review = {1},
	number = {41},
	pages = {e2316827121},
	pmc = {PMC11474074},
	pmid = {39312680},
	pst = {ppublish},
	title = {Migratory birds modulate niche tradeoffs in rhythm with seasons and life history},
	url = {https://doi.org/10.1073/pnas.2316827121},
