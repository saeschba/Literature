	keywords = {Solanum pimpinellifolium, denovo assembly, LA2093, structural variants, Solanum lycopersicum L., selection, domestication, improvement, modern breeding, eQTLs, cuticular waxes, flavonoids},
	mesh = {Domestication; Gene Expression Regulation, Plant; Genome, Plant; Genotype; Lycopene; Lycopersicon esculentum; Plant Breeding; Quantitative Trait Loci; Selection, Genetic; Sequence Analysis, DNA; Solanum},
	month = {11},
