	journal = JRStatSocB,
	journal_long = {Journal of the Royal Statistical Society. Series B (Methodological)},
	keywords = {prescribed statistical model, implicit statistical model, generating stochastic mechansim, likelihood},
	m1 = {ArticleType: research-article / Full publication date: 1984 / Copyright {\copyright}1984 Royal Statistical Society},
	month = {01},
	number = {2},
	pages = {193--227},
	publisher = {Blackwell Publishing for the Royal Statistical Society},
	title = {Monte Carlo Methods of Inference for Implicit Statistical Models},
	ty = {JOUR},
