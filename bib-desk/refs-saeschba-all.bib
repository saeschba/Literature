	journal = FrontPlantSci,
	journal-full = {Frontiers in plant science},
	journal_long = {Frontiers in Plant Sciences},
	keywords = {aroma; gene editing; machine learning; omics; tomato flavor; volatiles},
	pages = {1144113},
