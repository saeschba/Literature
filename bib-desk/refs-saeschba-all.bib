	keywords = {W chromosome; coevolution; gentes; maternal inheritance; mimicry},
	mesh = {Adaptation, Physiological; Animals; Biological Evolution; Biological Mimicry; Maternal Inheritance; Nesting Behavior; Passeriformes; Pigmentation},
	month = {Apr},
