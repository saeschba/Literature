	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {covid variant competition; logistic equation; selective sweep},
	mesh = {Humans; SARS-CoV-2; COVID-19; Epidemics; Influenza, Human; Disease Susceptibility},
	month = {Nov},
