	keywords = {Phytophthora infestans, gene copy number, effector genes, R genes},
	mesh = {Phytophthora infestans; Solanum tuberosum; Plant Diseases; Disease Resistance; Host-Pathogen Interactions; Virulence; Famine; Evolution, Molecular; Ireland; Alleles; Phylogeny; History, 19th Century},
	month = {Aug},
