	doi = {10.2307/3599438},
	isbn = {00220477},
	journal = JEcol,
	journal_long = {Journal of Ecology},
	keywords = {competition, ecotype, genetic correlation, heritability, root allocation},
	m1 = {ArticleType: research-article / Full publication date: Feb., 2004 / Copyright {\copyright}2004 British Ecological Society},
	month = {02},
	number = {1},
	pages = {57--71},
	publisher = {British Ecological Society},
	title = {Divergence and Variation of Quantitative Traits between Allozyme Genotypes of Avena barbata from Contrasting Habitats},
