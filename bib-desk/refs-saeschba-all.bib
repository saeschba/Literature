	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {adaptation; evolution; evolutionary biochemistry; genetics; population genetics},
	mesh = {Acclimatization; Adaptation, Physiological; Biological Evolution; Genetic Variation; Genetics; Phenotype; Selection, Genetic},
