	journal_long = {Genetics Research},
	keywords = {neutrality test, population subdivision, balancing selection, internal branches, linkage disequilibrium, island model, coalescent with recombination, power analysis},
	number = {1},
	pages = {65--79},
	publisher = {Cambridge University Press},
	title = {Recombination and the power of statistical tests of neutrality},
	ty = {JOUR},
	url = {https://www.cambridge.org/core/article/recombination-and-the-power-of-statistical-tests-of-neutrality/F66762884D13A7215EF59D45189D9E4B},
