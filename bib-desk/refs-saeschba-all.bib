	journal = AmNat,
	journal_long = {The American Naturalist},
	keywords = {speciation, prezygotic isolation, disruptive selection, isolation, allopatry, sympatry},
	m1 = {ArticleType: research-article / Issue Title: THE ECOLOGICAL GENETICS OF SPECIATION{$<$}break{$>$}{$<$}/break{$>$}A Symposium Organized by Sara Via / Full publication date: March 2002 / Copyright {\copyright}2002 The University of Chicago Press},
	month = {03},
	number = {S3},
	pages = {22--35},
	publisher = {The University of Chicago Press for The American Society of Naturalists},
	title = {Speciation by Natural and Sexual Selection: Models and Experiments},
