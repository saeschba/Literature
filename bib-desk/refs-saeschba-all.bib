	journal_long = {Genetics},
	keywords = {Drosophila simulans, divergence, Drosophila sechellia, Drosophila mauritiana, bottleneck, mutation load, isolation model, gene flow, isolation with migration, allopatric speciation},
	mesh = {Animals; Codon; DNA; DNA, Mitochondrial; Drosophila; Drosophila melanogaster; Evolution, Molecular; Genes, Insect; Genetics, Population; Insect Proteins; Models, Genetic; Mutation; Phylogeny; Polymorphism, Genetic; Species Specificity; Time Factors},
