	keywords = {CRISPR/Cas9; axillary meristematic cells; developmental regulators; isopentenyl transferase; virus-induced gene editing},
	mesh = {Solanum lycopersicum; Gene Editing; Plants, Genetically Modified; Meristem; RNA, Guide, CRISPR-Cas Systems; Genetic Vectors; CRISPR-Cas Systems; Plant Shoots; RNA Viruses; Alkyl and Aryl Transferases},
	month = {Sep},
