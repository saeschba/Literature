	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {Solanum lycopersicum; chromatin; genome topology},
	mesh = {Solanum lycopersicum; Histones; Epigenome; Epigenesis, Genetic; Genome, Plant; Chromatin; Plant Proteins; Gene Expression Regulation, Plant; Heterochromatin; Histone Code},
	month = {Jul},
