	journal = BMCBioinformatics,
	journal_long = {BMC Bioinformatics},
	keywords = {Fst outlier, genome scan},
	pages = {323--323},
	publisher = {BioMed Central},
	title = {{LOSITAN}: A workbench to detect molecular adaptation based on a {$F_{\mathrm{ST}}$}-outlier method},
	ty = {JOUR},
	u1 = {1471-2105-9-323{$[$}PII{$]$}; 18662398{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2515854/},
	volume = {9},
