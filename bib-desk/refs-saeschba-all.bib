	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {adaptive evolution; polyploid dynamics; structure variations; tetraploid cotton},
	mesh = {Coenzyme A; Cotton Fiber; Gossypium; Isomerases; Phosphopeptides; Plant Growth Regulators; Tetraploidy},
	month = {Sep},
	monthly-review = {1},
	number = {39},
