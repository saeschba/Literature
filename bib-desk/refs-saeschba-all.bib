	journal_long = {PLoS One},
	keywords = {exotic germplasm, plant breeding, tomato, Solanum lycopersicum L., sem-arid climate, subtropical climate, morphology, fruit quality, fruit yield, shelf life},
	number = {6},
	pages = {e0253557},
	pmc = {PMC8213146},
