@article{Huss:2019aa,
	abstract = {For a panmictic population of constant size evolving under neutrality, Kingman's coalescent describes the genealogy of a population sample in equilibrium. However, for genealogical trees under selection, not even expectations for most basic quantities like height and length of the resulting random tree are known. Here, we give an analytic expression for the distribution of the total tree length of a sample of size n under low levels of selection in a two-alleles model. We can prove that trees are shorter than under neutrality under genic selection and if the beneficial mutant has dominance h<1∕2, but longer for h>1∕2. The difference from neutrality is O(α2) for genic selection with selection intensity α and O(α) for other modes of dominance.},
	author = {Huss, Elisabeth and Pfaffelhuber, Peter},
	date-added = {2020-01-21 14:23:24 +0100},
	date-modified = {2020-01-29 09:57:42 +0100},
	doi = {10.1016/j.tpb.2019.10.002},
	journal = TheorPopulBiol,
	journal-full = {Theoretical population biology},
	journal_long = {Theoretical Population Biology},
	keywords = {Coalescent; Dominance coefficient; Tree length; Two-allele-model},
	month = {Nov},
	pages = {2--11},
	pmid = {31759974},
	pst = {aheadofprint},
	title = {Genealogical distances under low levels of selection},
	volume = {131},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1016/j.tpb.2019.10.002}}

