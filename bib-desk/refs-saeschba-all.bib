@inbook{Agrios:2009aa,
	abstract = {Plant pathogens are mostly certain microorganisms that can attack plants and cause disease. Plant diseases are caused by the same kinds of microorganisms, such as certain bacteria, viruses, fungi, nematodes, and protozoa, which cause disease in humans and animals. Plants are also attacked by certain parasitic plants and green algae, and by certain nonliving factors, such as nutrient deficiencies, pollutants, cold temperatures, and so on. Pathogens attack plants to obtain nutrients. Some pathogens are obligate parasites and can only live on living plants. Others can live off living or dead plant tissues. Pathogens enter plants through wounds, natural openings, or are carried and inserted by vectors such as insects. Pathogens invade plant tissues through enzymes that break down the cellular structure of cells and kill the cells. Pathogens also secrete other active compounds such as toxins, which kill cells directly, and growth regulators, which cause plant galls and overgrowths. Plants defend themselves against pathogens by preexisting structural and chemical defenses and by activating a number of chemical defenses that counterattack the pathogen and limit its advance or cause its death. Whether the pathogen can infect a plant or not depends on the genes for pathogenicity and virulence present in the pathogen and the genes for resistance or susceptibility present in the plant. Plant diseases cause financial losses, hungers and famines, food poisonings, and changes in the ecology and extinction of susceptible plant species. Many but not all plant diseases can be managed by using resistant varieties, treatment with pesticides, and, less, in other ways.},
	address = {Oxford},
	author = {Agrios, G. N.},
	booktitle = {Encyclopedia of Microbiology (Third Edition)},
	chapter = {Plant Pathogens and Disease: General Introduction},
	date = {2009/01/01/},
	date-added = {2024-06-27 14:47:50 +0200},
	date-modified = {2024-06-27 14:49:32 +0200},
	doi = {https://doi.org/10.1016/B978-012373944-5.00344-8},
	edition = {3rd edition},
	editor = {Schaechter, Moselio},
	isbn = {978-0-12-373944-5},
	keywords = {abiotic; bacteria; biotic; diagnosis; disease; effects; fungi; genetics; nematodes; pathogen; plant; resistance; viruses},
	pages = {613--646},
	publisher = {Academic Press},
	title = {Encyclopedia of Microbiology},
	url = {https://www.sciencedirect.com/science/article/pii/B9780123739445003448},
	year = {2009},
	bdsk-url-1 = {https://www.sciencedirect.com/science/article/pii/B9780123739445003448},
	bdsk-url-2 = {https://doi.org/10.1016/B978-012373944-5.00344-8}}

@article{Stukenbrock:2008aa,
	abstract = {Plant pathogens can emerge in agricultural ecosystems through several mechanisms, including host-tracking, host jumps, hybridization and horizontal gene transfer. High-throughput DNA sequencing coupled with new analytical approaches make it possible to differentiate among these mechanisms and to infer the time and place where pathogens first emerged. We present several examples to illustrate the different mechanisms and timescales associated with the origins of important plant pathogens. In some cases pathogens were domesticated along with their hosts during the invention of agriculture approximately 10,000 years ago. In other cases pathogens appear to have emerged very recently and almost instantaneously following horizontal gene transfer or hybridization. The predominant unifying feature in these examples is the environmental and genetic uniformity of the agricultural ecosystem in which the pathogens emerged. We conclude that agro-ecosystems will continue to select for new pathogens unless they are re-engineered to make them less conducive to pathogen emergence.},
	author = {Stukenbrock, Eva H and McDonald, Bruce A},
	date-added = {2024-06-27 13:49:14 +0200},
	date-modified = {2024-06-27 13:50:58 +0200},
	doi = {10.1146/annurev.phyto.010708.154114},
	journal = AnnuRevPhytopathol,
	journal-full = {Annual review of phytopathology},
	journal_long = {Annual Review of Phytopathology},
	keywords = {agriculural ecosystems, host-tracking, host-jumps, hybridisation, horizontal gene transfer},
	mesh = {Agriculture; Ecosystem; Host-Parasite Interactions; Plant Diseases; Plants},
	pages = {75--100},
	pmid = {18680424},
	pst = {ppublish},
	title = {The origins of plant pathogens in agro-ecosystems},
	url = {https://doi.org/10.1146/annurev.phyto.010708.154114},
	volume = {46},
	year = {2008},
	bdsk-url-1 = {https://doi.org/10.1146/annurev.phyto.010708.154114}}

@article{Read:1994aa,
	abstract = {Why is there variation in the virulence of infectious diseases? Virulence can have substantial effects on the genetic contribution of both host and pathogen to future generations. Understanding it therefore requires explanation not only in terms of cellular and molecular mechanisms, but also in evolutionary terms: what is the nature of the selection acting on genes responsible for virulence?},
	author = {Read, A F},
	date-added = {2024-06-27 13:47:22 +0200},
