	abstract = {Nature-based climate solutions (NbCS) hold promise, but must be based on the best available science to be successful. We outline key ingredients of open data and science crucial for robust and scalable nature-based climate solutions efforts, as an urgent call to action for academic researchers, nongovernmental organizations, government agencies, and private companies.},
