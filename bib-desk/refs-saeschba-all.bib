	doi = {10.1371/journal.pgen.1011339},
	journal = PLoSGenet,
	journal-full = {PLoS genetics},
	journal_long = {PLoS Genetics},
	keywords = {varcose veins, exome sequencing, candidate genetic variatns},
	mesh = {Humans; Varicose Veins; Female; Exome Sequencing; Male; Genome-Wide Association Study; Genetic Predisposition to Disease; Exome; Polymorphism, Single Nucleotide; Endothelin-Converting Enzymes; Middle Aged; Genetic Variation; Adult; Ion Channels},
	month = {Jul},
	number = {7},
	pages = {e1011339},
	pmc = {PMC11233024},
	pmid = {38980841},
	pst = {epublish},
	title = {Exome sequencing identifies novel genetic variants associated with varicose veins},
	url = {https://doi.org/10.1371/journal.pgen.1011339},
	volume = {20},
	year = {2024},
