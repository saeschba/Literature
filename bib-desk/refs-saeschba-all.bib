	doi = {10.1111/nph.18301},
	journal = NewPhytol,
	journal-full = {The New phytologist},
	journal_long = {New Phytologist},
	keywords = {DNA methylation; epigenetics; flavor volatiles; fruit aroma; fruit ripening; tomato; transcription factor},
	mesh = {DNA; Fatty Acids; Fruit; Gene Expression Regulation, Plant; Solanum lycopersicum; Plant Proteins; Transcription Factors},
	month = {Sep},
	number = {5},
	pages = {1913--1926},
	pmid = {35686614},
	pst = {ppublish},
	title = {The role and interaction between transcription factor {NAC-NOR} and {DNA} demethylase {SlDML2} in the biosynthesis of tomato fruit flavor volatiles},
	url = {https://doi.org/10.1111/nph.18301},
	volume = {235},
