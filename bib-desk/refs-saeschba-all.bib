	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {UK Biobank; genetic conflict; genomics; sexually antagonistic selection},
	mesh = {Humans; Male; Female; Multifactorial Inheritance; Fertility; Selection, Genetic; Haplotypes; Alleles; Sex Characteristics; Genome-Wide Association Study; Genome, Human},
	month = {Sep},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {39},
	pages = {e2412315121},
	pmc = {PMC11441502},
	pmid = {39302970},
	pst = {ppublish},
	title = {The battle of the sexes in humans is highly polygenic},
	url = {https://doi.org/10.1073/pnas.2412315121},
	volume = {121},
