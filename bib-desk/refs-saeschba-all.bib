	month = {Jun},
	number = {1},
	pages = {5102},
	pmc = {PMC11178782},
	pmid = {38877009},
	pst = {epublish},
	title = {The effector-triggered immunity landscape of tomato against \emph{{Pseudomonas syringae}}},
