	doi = {10.1371/journal.pbio.3002699},
	journal = PLoSBiol,
	journal-full = {PLoS biology},
	journal_long = {PLoS Biology},
	keywords = {social learning, environmental change, payoff},
	mesh = {Animals; Social Behavior; Passeriformes; Environment; Social Learning; Animal Migration; Male; Learning; Behavior, Animal; Female; Ecosystem},
	month = {Nov},
	monthly-review = {1},
	number = {11},
	pages = {e3002699},
