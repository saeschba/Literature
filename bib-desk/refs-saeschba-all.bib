@article{Day:1997vo,
	abstract = {Mating type, in vitro sensitivity to the phenylamide fungicide metalaxyl, and mitochondrial (mtDNA) haplotype were determined in some or all of 618 isolates of Phytophthora infestans from the years between 1978 and 1995. A2 mating type occurred infrequently in most but not all years and insensitivity to metalaxyl increased over time. After 1982, the mtDNA Ib haplotype was largely replaced (except for one isolate in 1986 and one in 1995) by two new haplotypes, Ia and IIa. Type Ia was much more common than type IIa.},
