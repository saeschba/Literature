	keywords = {Solanum lycopersicum, fruit flavour, fruit yield, light extinction coefficient, simulation-based genome-assisted breeding},
	mesh = {Breeding; Chromosome Mapping; Computer Simulation; Genetics, Population; Genome, Plant; Genome-Wide Association Study; Linkage Disequilibrium; Lycopersicon esculentum; Models, Genetic; Phenotype; Quantitative Trait Loci; Quantitative Trait, Heritable; Selection, Genetic},
	month = {Jan},
	pages = {19454},
	pmc = {PMC4726135},
