	isbn = {0168-9525},
	journal = TrendsGenet,
	journal_long = {Trends in Genetics},
	keywords = {sex chromosomes, recombination, mating system, pseudo-autosomal region, dosage compensation, sex-determining region, review, breeding system, genomic conflicts},
	month = {9},
	number = {9},
	pages = {350--357},
	title = {Are all sex chromosomes created equal?},
	ty = {JOUR},
