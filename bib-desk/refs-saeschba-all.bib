	doi = {10.1007/s10592-008-9718-7},
	isi = {ISI:000267104000046},
	issn = {1566-0621},
	journal = ConservGenet,
	keywords = {inbreeding, genetic drift, migration, population differentiation, simulated annealing},
	month = {Aug},
