	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {ecotoxicology; mercury; spatial distribution},
	mesh = {Animals; Mercury; Atlantic Ocean; Feathers; Arctic Regions; Greenland; Environmental Monitoring; Birds; Food Chain; Water Pollutants, Chemical; Ecosystem},
