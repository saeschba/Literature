	doi = {10.1038/s41586-024-08186-2},
	journal = Nature,
	journal-full = {Nature},
	journal_long = {Nature},
	keywords = {Solanum lycopersicum, fruit sugar, gene editing, fruit quality, calcium-dependent protein kinase 27, SlCDPK27, SlCPK27},
	mesh = {Fructose; Fruit; Gene Editing; Gene Expression Regulation, Plant; Germination; Glucose; Glucosyltransferases; Phosphorylation; Plant Proteins; Seeds; Solanum lycopersicum; Sugars; Genes, Plant; Mutation; Proteolysis},
	month = {Nov},
