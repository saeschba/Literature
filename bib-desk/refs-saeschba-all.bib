@article{Huchard:2013fk,
	abstract = {Sexual selection theory suggests that choice for partners carrying dissimilar genes at the major histocompatibility complex (MHC) may play a role in maintaining genetic variation in animal populations by limiting inbreeding or improving the immunity of future offspring. However, it is often difficult to establish whether the observed MHC dissimilarity among mates drives mate choice or represents a by-product of inbreeding avoidance based on MHC-independent cues. Here, we used 454-sequencing and a 10-year study of wild grey mouse lemurs (Microcebus murinus), small, solitary primates from western Madagascar, to compare the relative importance on the mate choice of two MHC class II genes, DRB and DQB, that are equally variable but display contrasting patterns of selection at the molecular level, with DRB under stronger diversifying selection. We further assessed the effect of the genetic relatedness and of the spatial distance among candidate mates on the detection of MHC-dependent mate choice. Our results reveal inbreeding avoidance, along with disassortative mate choice at DRB, but not at DQB. DRB-disassortative mate choice remains detectable after excluding all related dyads (characterized by a relatedness coefficient r > 0), but varies slightly with the spatial distance among candidate mates. These findings suggest that the observed deviations from random mate choice at MHC are driven by functionally important MHC genes (like DRB) rather than passively resulting from inbreeding avoidance and further emphasize the need for taking into account the spatial and genetic structure of the population in correlative tests of MHC-dependent mate choice.},
	author = {Huchard, Elise and Baniel, Alice and Schliehe-Diecks, Susanne and Kappeler, Peter M.},
	date-added = {2013-07-26 05:46:24 +0000},
	date-modified = {2013-07-26 05:46:36 +0000},
	doi = {10.1111/mec.12349},
	issn = {1365-294X},
	journal = MolEcol,
	journal_long = {Molecular Ecology},
	keywords = {grey mouse lemur, inbreeding avoidance, major histocompatibility complex, mate choice, sexual selection, spatial genetic structure},
	number = {15},
	pages = {4071--4086},
	title = {MHC-disassortative mate choice and inbreeding avoidance in a solitary primate},
	url = {http://dx.doi.org/10.1111/mec.12349},
	volume = {22},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1111/mec.12349}}

@article{Kobayashi:2008fk,
	abstract = {Genetic influx into a population often does not correspond to the real migration rate ( m ) of individuals, due to class structure within the population. The effective migration rate ( m e ) is a concept to measure gene flow in such a situation. The ratio of the effective migration rate to the real migration rate ( m e m ) is called the gene flow factor, and represents the degree of gene flow modification. Prior authors proposed different definitions of the effective migration rate. These may be categorized into two groups: the neutral effective migration rate and the selective effective migration rate. In this article, we construct a general model of a class-structured population with a mainland-island structure. Using the model, we prove that the gene flow factor of the neutral effective migration rate converges to the mean reproductive value of immigrants if the limit is taken with the real migration rate converging to zero. This limit theorem provides a novel interpretation of gene flow and can be used to derive approximation formulae of the neutral effective migration rate. We illustrate this method analyzing two examples, sex ratio distortion due to extrinsic factors and hybrid zones with underdominance. },
	annote = {- KHT2008 mention that a variety of previous studies have introduced a notion of effective migration rate (EMR) (Petry 1983, Bengthsson 1985, Barton and Bengtsson 1986, Ingvarsson and Whitlock 2000, Telschow et al. 2002, Rousse 2004, Telschow et al. 2006). KHT2008 distinguish between two classes of EMR: "netural" and "selective" EMR.

- Neutral EMR: based on allele frequency changes at a neutral locus, regarding selection as an external factor (Barton and Bengtsson 1986).

- Selective EMR: quantifies gene flow from balancing selection and migration pressures; defined using equilibrium allele frequencies (Telschow et al. 2006).

- KHT2008 are concerned only with neutral EMR (simply called EMR hereafter).

- The gene flow factor is defined as GFF = m_e/m; it is inversely proportional to the strength of the genetical barrier to gene flow (cf. Barton and Bengtsson 1986).

- The paper aims at proving the following limit theorem: The GFF converges to the mean reproductive value of immigrants if the limit is taken with immigration and emigration rates converging to zero.

- The reproductive value RV is devined as the relative contribution of the focal individual to the gene pool of the population in the distant future (Fisher 1930, Taylor 1990).

- The effective migration rate m_e is defined as m_e := lim_{t -> +inf} [p(t+1) - p(t)]/([q - q(t)]), where q is the frequency of the focal neutral allele on the continent and p(t) is its frequency at time t on the island.},
	author = {Kobayashi, Yutaka and Hammerstein, Peter and Telschow, Arndt},
	date-added = {2013-07-25 08:25:23 +0000},
	date-modified = {2013-11-13 07:46:40 +0000},
	doi = {http://dx.doi.org/10.1016/j.tpb.2008.05.001},
	issn = {0040-5809},
	journal = TheorPopulBiol,
	journal_long = {Theoretical Population Biology},
	keywords = {gene flow, effective gene flow, population structure, neutral effective migration rate, selective effective migration rate, genetic barrier, hybrid zone, sex ratio, speciation, reproductive isolation, biodiversity},
	number = {1},
	pages = {84--92},
	title = {The neutral effective migration rate in a mainland--island context},
	url = {http://www.sciencedirect.com/science/article/pii/S0040580908000567},
	volume = {74},
	year = {2008},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S0040580908000567},
	bdsk-url-2 = {http://dx.doi.org/10.1016/j.tpb.2008.05.001}}

@article{Simonsen:1995fk,
	abstract = {A class of statistical tests based on molecular polymorphism data is studied to determine size and power properties. The class includes Tajima's D statistic as well as the D* and F* tests proposed by Fu and Li. A new method of constructing critical values for these tests is described. Simulations indicate that Tajima's test is generally most powerful against the alternative hypotheses of selective sweep, population bottleneck, and population subdivision, among tests within this class. However, even Tajima's test can detect a selective sweep or bottleneck only if it has occurred within a specific interval of time in the recent past or population subdivision only when it has persisted for a very long time. For greatest power against the particular alternatives studied here, it is better to sequence more alleles than more sites.},
	author = {Simonsen, K L and Churchill, G A and Aquadro, C F},
	date-added = {2013-07-24 13:38:23 +0000},
	date-modified = {2013-08-06 20:20:43 +0000},
	eprint = {http://www.genetics.org/content/141/1/413.full.pdf+html},
	journal = Genetics,
	journal_long = {Genetics},
	keywords = {demographic inference, selection, statistical inference, neutrality test},
	number = {1},
	pages = {413-29},
	title = {Properties of statistical tests of neutrality for {DNA} polymorphism data.},
	url = {http://www.genetics.org/content/141/1/413.abstract},
	volume = {141},
	year = {1995},
	bdsk-url-1 = {http://www.genetics.org/content/141/1/413.abstract}}

@article{Xing:2013uq,
	abstract = {<title>Author Summary</title><p>Throughout history, Mongolians have survived the harsh conditions of northern latitudes, including seasonal cold, drought, and a restricted diet. Approximately 500 years ago, nomadic Deedu (DU; ``at high altitude'') Mongolians migrated from the Mongolian steppes to the northeastern highlands of the Qinghai-Tibetan Plateau. Using high-density SNP data, we demonstrate that present-day DU Mongolians share genetic ancestry with other Mongolians and with Tibetans. High-altitude selection candidate genes previously identified in the latter population (<italic>EPAS1</italic>, <italic>PKLR</italic>, <italic>CYP2E1</italic>), and <italic>PPARG</italic>, a gene long hypothesized to play a role in metabolic adaptation, are among the strongest adaptive signals in DU Mongolians. Furthermore, we show that hemoglobin concentration, associated with high-altitude adaptation in Tibetans, is intermediate in DU Mongolians compared to Tibetans and Han Chinese at comparable altitudes. Whole-genome sequence from a DU Mongolian shows that approximately 300 protein-coding changes are specific to this individual. Our analyses provide new perspectives on genetic variation and adaptation to extreme environments.</p>},
	author = {Xing, , Jinchuan AND Wuren, , Tana AND Simonson, , Tatum S. AND Watkins, , W. Scott AND Witherspoon, , David J. AND Wu, , Wilfred AND Qin, , Ga AND Huff, , Chad D. AND Jorde, , Lynn B. AND Ge, , Ri-Li},
	date-added = {2013-07-19 05:39:09 +0000},
	date-modified = {2013-07-19 05:40:33 +0000},
	doi = {10.1371/journal.pgen.1003634},
	journal = PLoSGenet,
	journal_long = {PLoS Genetics},
	keywords = {adaptation to high altitude, human evolution, Tibetians, local adaptation, Mongolians, metabolic adaptation, hemoglobin, extreme environments},
	month = {07},
	number = {7},
	pages = {e1003634},
	publisher = {Public Library of Science},
	title = {Genomic Analysis of Natural Selection and Phenotypic Variation in High-Altitude Mongolians},
	url = {http://dx.doi.org/10.1371%2Fjournal.pgen.1003634},
	volume = {9},
	year = {2013},
	bdsk-url-1 = {http://dx.doi.org/10.1371%2Fjournal.pgen.1003634},
	bdsk-url-2 = {http://dx.doi.org/10.1371/journal.pgen.1003634}}

