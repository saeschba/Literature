	journal_long = {Evolution},
	keywords = {chromosome evolution, fixation probability, shifting balance, stochastic processes, chromosomal rearrangement, transition-matrix approach},
	m1 = {ArticleType: research-article / Full publication date: May, 1991 / Copyright {\copyright}1991 Society for the Study of Evolution},
	month = {05},
	number = {3},
	pages = {499--517},
	publisher = {Society for the Study of Evolution},
	title = {The Probability of Fixation of a New Karyotype in a Continuous Population},
