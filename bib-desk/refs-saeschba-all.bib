	keywords = {honeybee, PSMC},
	l3 = {10.1038/ng.3077; http://www.nature.com/ng/journal/v46/n10/abs/ng.3077.html#supplementary-information},
	m3 = {Article},
	month = {10},
	number = {10},
	pages = {1081--1088},
	publisher = {Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved.},
	title = {A worldwide survey of genome sequence variation provides insight into the evolutionary history of the honeybee \emph{{Apis mellifera}}},
