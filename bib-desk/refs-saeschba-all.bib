	annote2 = {Accession Number: 6428996; Kennedy, Marc C.; O'Hagan, Anthony; Issue Info: Sep2001, Vol. 63 Issue 3, p425; Subject Term: GAUSSIAN processes; Subject Term: INTERPOLATION; Number of Pages: 40p; Document Type: Article},
	author = {Kennedy, Marc C. and O'Hagan, Anthony},
	date = {2001/09//},
