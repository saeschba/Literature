	pmc = {PMC11067064},
	pmid = {38648483},
	pst = {ppublish},
	title = {Mapping seasonal migration in a songbird hybrid zone -- heritability, genetic correlations, and genomic patterns linked to speciation},
	url = {https://doi.org/10.1073/pnas.2313442121},
	volume = {121},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1073/pnas.2313442121}}

@article{Achille:2024aa,
	abstract = {Over the past few years, machine learning models have significantly increased in size and complexity, especially in the area of generative AI such as large language models. These models require massive amounts of data and compute capacity to train, to the extent that concerns over the training data (such as protected or private content) cannot be practically addressed by retraining the model "from scratch" with the questionable data removed or altered. Furthermore, despite significant efforts and controls dedicated to ensuring that training corpora are properly curated and composed, the sheer volume required makes it infeasible to manually inspect each datum comprising a training corpus. One potential approach to training corpus data defects is model disgorgement, by which we broadly mean the elimination or reduction of not only any improperly used data, but also the effects of improperly used data on any component of an ML model. Model disgorgement techniques can be used to address a wide range of issues, such as reducing bias or toxicity, increasing fidelity, and ensuring responsible use of intellectual property. In this paper, we survey the landscape of model disgorgement methods and introduce a taxonomy of disgorgement techniques that are applicable to modern ML systems. In particular, we investigate the various meanings of "removing the effects" of data on the trained model in a way that does not require retraining from scratch.},
	author = {Achille, Alessandro and Kearns, Michael and Klingenberg, Carson and Soatto, Stefano},
	date-added = {2024-05-06 09:11:29 +0200},
	date-modified = {2024-05-06 09:16:12 +0200},
	doi = {10.1073/pnas.2307304121},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences USA},
	keywords = {artificial intelligence; generative AI; machine learning; machine unlearning; model disgorgement},
	mesh = {Language; Machine Learning},
	month = {Apr},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {18},
	pages = {e2307304121},
	pmc = {PMC11067471},
	pmid = {38640257},
	pst = {ppublish},
	title = {{AI} model disgorgement: Methods and choices},
	url = {https://doi.org/10.1073/pnas.2307304121},
	volume = {121},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1073/pnas.2307304121}}

@article{Hadjitofi:2024aa,
	abstract = {The honeybee waggle dance has been widely studied as a communication system, yet we know little about how nestmates assimilate the information needed to navigate toward the signaled resource. They are required to detect the dancer's orientation relative to gravity and duration of the waggle phase and translate this into a flight vector with a direction relative to the sun1 and distance from the hive.2,3 Moreover, they appear capable of doing so from varied, dynamically changing positions around the dancer. Using high-speed, high-resolution video, we have uncovered a previously unremarked correlation between antennal position and the relative body axes of dancer and follower bees. Combined with new information about antennal inputs4,5 and spatial encoding in the insect central complex,6,7 we show how a neural circuit first proposed to underlie path integration could be adapted to decoding the dance and acquiring the signaled information as a flight vector that can be followed to the resource. This provides the first plausible account of how the bee brain could support the interpretation of its dance language.},
	author = {Hadjitofi, Anna and Webb, Barbara},
	date-added = {2024-05-06 09:03:17 +0200},
	date-modified = {2024-05-06 09:03:34 +0200},
	doi = {10.1016/j.cub.2024.02.045},
	journal = CurrBiol,
	journal-full = {Current biology : CB},
	journal_long = {Current Biology},
	keywords = {Apis mellifera; antennal positioning; central complex; dance communication; honeybee; mechanosensory input; vector assimilation; waggle dance},
	mesh = {Animals; Bees; Arthropod Antennae; Animal Communication; Flight, Animal},
	month = {Apr},
	number = {8},
	pages = {1772--1779.e4},
	pmid = {38479387},
	pst = {ppublish},
	title = {Dynamic antennal positioning allows honeybee followers to decode the dance},
	url = {https://doi.org/10.1016/j.cub.2024.02.045},
	volume = {34},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1016/j.cub.2024.02.045}}

@article{Cahoon:2024aa,
	abstract = {Genotype imputation is now fundamental for genome-wide association studies but lacks fairness due to the underrepresentation of references from non-European ancestries. The state-of-the-art imputation reference panel released by the Trans-Omics for Precision Medicine (TOPMed) initiative improved the imputation of admixed African-ancestry and Hispanic/Latino samples, but imputation for populations primarily residing outside of North America may still fall short in performance due to persisting underrepresentation. To illustrate this point, we imputed the genotypes of over 43,000 individuals across 123 populations around the world and identified numerous populations where imputation accuracy paled in comparison to that of European-ancestry populations. For instance, the mean imputation r-squared (Rsq) for variants with minor allele frequencies between 1% and 5% in Saudi Arabians (n = 1,061), Vietnamese (n = 1,264), Thai (n = 2,435), and Papua New Guineans (n = 776) were 0.79, 0.78, 0.76, and 0.62, respectively, compared to 0.90-0.93 for comparable European populations matched in sample size and SNP array content. Outside of Africa and Latin America, Rsq appeared to decrease as genetic distances to European-ancestry reference increased, as predicted. Using sequencing data as ground truth, we also showed that Rsq may over-estimate imputation accuracy for non-European populations more than European populations, suggesting further disparity in accuracy between populations. Using 1,496 sequenced individuals from Taiwan Biobank as a second reference panel to TOPMed, we also assessed a strategy to improve imputation for non-European populations with meta-imputation, but this design did not improve accuracy across frequency spectra. Taken together, our analyses suggest that we must ultimately strive to increase diversity and size to promote equity within genetics research.},
	author = {Cahoon, Jordan L and Rui, Xinyue and Tang, Echo and Simons, Christopher and Langie, Jalen and Chen, Minhui and Lo, Ying-Chu and Chiang, Charleston W K},
	date-added = {2024-05-06 08:30:40 +0200},
	date-modified = {2024-05-06 08:31:29 +0200},
	doi = {10.1016/j.ajhg.2024.03.011},
	journal = AmJHumGenet,
	journal-full = {American journal of human genetics},
	journal_long = {American Journal of Human Genetics},
	keywords = {imputation, human populations, out-of-sample prediction, TOPMed},
	mesh = {Humans; Polymorphism, Single Nucleotide; Genome-Wide Association Study; Gene Frequency; Genetics, Population; Genotype; Genome, Human; White People},
	month = {May},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {5},
	pages = {979--989},
	pmid = {38604166},
	pst = {ppublish},
	title = {Imputation accuracy across global human populations},
	url = {https://doi.org/10.1016/j.ajhg.2024.03.011},
	volume = {111},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1016/j.ajhg.2024.03.011}}

@article{McQuillan:2024aa,
	abstract = {Leukocyte telomere length (LTL) varies significantly across human populations, with individuals of African ancestry having longer LTL than non-Africans. However, the genetic and environmental drivers of LTL variation in Africans remain largely unknown. We report here on the relationship between LTL, genetics, and a variety of environmental and climatic factors in ethnically diverse African adults (n = 1,818) originating from Botswana, Tanzania, Ethiopia, and Cameroon. We observe significant variation in LTL among populations, finding that the San hunter-gatherers from Botswana have the longest leukocyte telomeres and that the Fulani pastoralists from Cameroon have the shortest telomeres. Genetic factors explain ∼50% of LTL variation among individuals. Moreover, we observe a significant negative association between Plasmodium falciparum malaria endemicity and LTL while adjusting for age, sex, and genetics. Within Africa, adults from populations indigenous to areas with high malaria exposure have shorter LTL than those in populations indigenous to areas with low malaria exposure. Finally, we explore to what degree the genetic architecture underlying LTL in Africa covaries with malaria exposure.},
	author = {McQuillan, Michael A and Verhulst, Simon and Hansen, Matthew E B and Beggs, William and Meskel, Dawit Wolde and Belay, Gurja and Nyambo, Thomas and Mpoloka, Sununguko Wata and Mokone, Gaonyadiwe George and Fokunang, Charles and Njamnshi, Alfred K and Chanock, Stephen J and Aviv, Abraham and Tishkoff, Sarah A},
	date-added = {2024-05-06 08:29:04 +0200},
