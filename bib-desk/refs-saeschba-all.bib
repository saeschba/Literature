	issn = {0002-9297},
	journal = AmJHumGenet,
	journal_long = {American Journal of Human Genetics},
	keywords = {HLA, MHC, human evolution, human populations, overdominance},
	number = {4},
	pages = {943--952},
	publication-type = {J},
	times-cited = {46},
	title = {{HLA} polymorphism in the {H}avasupai -- evidence for balancing selection},
	volume = {53},
	year = {1993}}

