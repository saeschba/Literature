	date-modified = {2017-11-29 10:23:20 +0000},
	isbn = {0737-4038},
	journal = MolBiolEvol,
	journal_long = {Molecular Biology and Evolution},
	keywords = {chicken, Serama, genome, body size, dwarfism, selection},
	m3 = {doi: 10.1093/molbev/msx227},
	month = {12},
	number = {12},
	pages = {3081--3088},
	title = {An Evolutionary Genomic Perspective on the Breeding of Dwarf Chickens},
	ty = {JOUR},
