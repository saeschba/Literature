	journal = Genetics,
	journal_long = {Genetics},
	keywords = {Drosophila melanogaster, ecotypes, adaptive divergence, genomic divergence, cline, demographic history, spatially varying selection, adaptation},
	month = {May},
	number = {1},
	pages = {455--473},
	publication-type = {J},
	times-cited = {39},
	title = {{Genomic analysis of adaptive differentiation in \emph{Drosophila melanogaster}}},
	volume = {179},
