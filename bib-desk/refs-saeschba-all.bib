	mesh = {Adaptation, Physiological; Amino Acid Sequence; Computational Biology; DNA Copy Number Variations; Epistasis, Genetic; Evolution, Molecular; Genes; Genome; Host Specificity; Host-Parasite Interactions; Lycopersicon esculentum; Molecular Sequence Data; Phytophthora; Phytophthora infestans; Plant Diseases; Polymorphism, Single Nucleotide; Proteins; Selection, Genetic; Sequence Analysis, DNA; Solanum tuberosum},
	month = {Dec},
