	keywords = {repetitive DNA, phylogenetic inference, next-generation sequencing},
	pages = {378--378},
	publisher = {BioMed Central},
	title = {Graph-based clustering and characterization of repetitive sequences in next-generation sequencing data},
	ty = {JOUR},
	u1 = {1471-2105-11-378{$[$}PII{$]$}; 20633259{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2912890/},
	volume = {11},
