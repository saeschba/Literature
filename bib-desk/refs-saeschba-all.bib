	j2 = {Philos Trans R Soc Lond B Biol Sci},
	journal = PhilosTransRSocLondBBiolSci,
	journal_long = {Philosophical Transactions of the Royal Society B: Biological Sciences},
	keywords = {allelism, Bacillus thuringensis, diamondback moths, evolution, genetic variation, resistance},
