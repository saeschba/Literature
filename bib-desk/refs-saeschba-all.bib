	journal_long = {Molecular Ecology},
	keywords = {adaptive capacity; conservation units; effective population size; genetic rescue; inbreeding depression; population connectivity},
	mesh = {Animals; Animals, Wild; Biodiversity; Conservation of Natural Resources; Genetics, Population; Metagenomics},
	month = {Jan},
	number = {1},
	pages = {62--82},
	pmc = {PMC7894518},
	pmid = {33145846},
