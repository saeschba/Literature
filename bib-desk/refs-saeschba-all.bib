	month = {May},
	number = {Pt 5},
	pages = {471--479},
	pmid = {15229999},
	pst = {ppublish},
	title = {Identity of the {mtDNA} haplotype(s) of \empn{{Phytophthora infestans}} in historical specimens from the {I}rish potato famine},
