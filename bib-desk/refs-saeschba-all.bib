	journal = CanJFishAquatSci,
	journal_long = {Canadian Journal of Fisheries and Aquatic Sciences},
	keywords = {effective population size, Whirling disease, Myxobolus cerebralis, rainbow trout, Vibrio anguillarum, Atlantic salmon, Pacific salmon, MHC},
	language = {English},
