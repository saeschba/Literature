	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {DNA repair; adaptive walk; distribution of fitness effects; mutation bias; pleiotropy},
	mesh = {Phylogeny; Mutation; Adaptation, Physiological; Acclimatization; Genome; Selection, Genetic; Evolution, Molecular},
	month = {May},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {22},
	pages = {e2207355120},
	pmc = {PMC10235995},
	pmid = {37216547},
	pst = {ppublish},
	title = {Shifts in mutation spectra enhance access to beneficial mutations},
	url = {https://doi.org/10.1073/pnas.2207355120},
	volume = {120},
