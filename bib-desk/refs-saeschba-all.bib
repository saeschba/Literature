	journal = ProcNatlAcadSciUSA,
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {simulation, posterior distribution, likelihood function, Markov chain Monte Carlo},
	number = {26},
	pages = {15324--15328},
	title = {Markov chain {M}onte {C}arlo without likelihoods},
	ty = {JOUR},
