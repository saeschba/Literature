	journal-full = {Development (Cambridge, England)},
	journal_long = {Development},
	keywords = {Arabidopsis; CLAVATA-WUSCHEL; Maize; Rice; Shoot meristem; Signaling; Tomato},
	mesh = {Arabidopsis; Arabidopsis Proteins; Gene Expression Regulation, Plant; Homeodomain Proteins; Meristem; Signal Transduction},
	month = {09},
	number = {18},
	pages = {3238--3248},
