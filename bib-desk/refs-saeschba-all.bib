	pmc = {PMC11588045},
	pmid = {39527741},
	pst = {ppublish},
	title = {Interdisciplinary insights into the cultural and chronological context of chili pepper (Capsicum annuum var. annuum L.) domestication in Mexico},
	url = {https://doi.org/10.1073/pnas.2413764121},
