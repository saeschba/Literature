	journal_long = {Science},
	keywords = {Neanderthal, Vindija, human evolution},
	mesh = {Alleles; Animals; Biological Evolution; Caves; Croatia; DNA, Ancient; Genome; Humans; Neanderthals},
	month = {11},
	number = {6363},
	pages = {655--658},
	pmc = {PMC6185897},
