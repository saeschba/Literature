	keywords = {chromosom inversion, local adaptation, Drosophila melanogaster},
	month = {04},
	number = {7},
	pages = {1813--1827},
	publisher = {BlackWell Publishing Ltd},
	title = {Inference of chromosomal inversion dynamics from Pool-Seq data in natural and laboratory populations of \emph{{Drosophila melanogaster}}},
	ty = {JOUR},
	u1 = {24372777{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC4359753/},
	volume = {23},
