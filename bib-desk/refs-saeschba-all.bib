	keywords = {transposable elements, TE insertion polymorphism, transcript isoforms, GWAS, secondary metabolites, agronomic traits},
	mesh = {DNA Transposable Elements; Evolution, Molecular; Genome, Plant; Genome-Wide Association Study; Lycopersicon esculentum; Polymorphism, Genetic},
	month = {08},
