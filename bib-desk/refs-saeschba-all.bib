	volume = {16},
	year = {2018},
	bdsk-url-1 = {https://doi.org/10.1371/journal.pbio.2006125}}

@article{Cubry:2018if,
	abstract = {African rice (Oryza glaberrima) was domesticated independently from Asian rice. The geographical origin of its domestication remains elusive. Using 246 new whole-genome sequences, we inferred the cradle of its domestication to be in the Inner Niger Delta. Domestication was preceded by a sharp decline of most wild populations that started more than 10,000 years ago. The wild population collapse occurred during the drying of the Sahara. This finding supports the hypothesis that depletion of wild resources in the Sahara triggered African rice domestication. African rice cultivation strongly expanded 2,000 years ago. During the last 5 centuries, a sharp decline of its cultivation coincided with the introduction of Asian rice in Africa. A gene, PROG1, associated with an erect plant architecture phenotype, showed convergent selection in two rice cultivated species, Oryza glaberrima from Africa and Oryza sativa from Asia. In contrast, a shattering gene, SH5, showed selection signature during African rice domestication, but not during Asian rice domestication. Overall, our genomic data revealed a complex history of African rice domestication influenced by important climatic changes in the Saharan area, by the expansion of African agricultural society, and by recent replacement by another domesticated species.},
	annote = {doi: 10.1016/j.cub.2018.05.066},
	author = {Cubry, Philippe and Tranchant-Dubreuil, Christine and Thuillet, Anne-C{\'e}line and Monat, C{\'e}cile and Ndjiondjop, Marie-Noelle and Labadie, Karine and Cruaud, Corinne and Engelen, Stefan and Scarcelli, Nora and Rhon{\'e}, B{\'e}n{\'e}dicte and Burgarella, Concetta and Dupuy, Christian and Larmande, Pierre and Wincker, Patrick and Fran{\c c}ois, Olivier and Sabot, Fran{\c c}ois and Vigouroux, Yves},
	booktitle = {Current Biology},
