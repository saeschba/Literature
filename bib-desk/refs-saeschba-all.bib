@article{Bonacic:2019aa,
	abstract = {The proliferation of feral domestic animals (FDAs) has been favored by human-induced landscape changes, a world population becoming increasingly urban, and by inappropriate management of domestic animals. Here, we describe the impact of FDAs and the opposing views in societies that affect the decision-making process and management actions. We provide general recommendations for the participatory management of this emerging threat to biodiversity and rural ecosystems.},
