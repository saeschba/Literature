	keywords = {CRISPR/Cas; Solanum lycopersicum; TALE nucleases; abiotic stress; pathogen resistance; plant architecture; tomato domestication; zinc finger nucleases},
	mesh = {Gene Editing; Solanum lycopersicum; Genome, Plant; CRISPR-Cas Systems; Crops, Agricultural; Plant Breeding},
