	doi = {10.1038/s41467-018-07216-8},
	journal = NatCommun,
	journal-full = {Nature communications},
	journal_long = {Nature Communications},
	keywords = {fruit shape, OVATE family proteins, TONNEAU1 recruiting motif proteins, tomato, Solanum lycopersicum},
	mesh = {Amino Acid Sequence; Biodiversity; Cell Division; Fruit; Genetic Complementation Test; Models, Biological; Physical Chromosome Mapping; Plant Proteins; Plants; Protein Binding; Saccharomyces cerevisiae},
	month = {11},
	number = {1},
	pages = {4734},
	pmc = {PMC6226536},
