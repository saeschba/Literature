	doi = {10.1073/pnas.2319104121},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {embryo mortality; inbreeding; infertility; population demographics; sex ratio},
	mesh = {Animals; Female; Male; Endangered Species; Reproduction; Inbreeding; Infertility; Birds; Fertilization},
	month = {Sep},
	monthly-review = {1},
	number = {36},
	pages = {e2319104121},
