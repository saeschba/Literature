	journal = DNARes,
	journal-full = {DNA research : an international journal for rapid publication of reports on genes and genomes},
	journal_long = {DNA Research},
	keywords = {Solanum lycopersicum; genetic variation; insertion--deletion},
	mesh = {Computer Simulation; Genetic Markers; Genome, Plant; INDEL Mutation; Lycopersicon esculentum; Polymorphism, Genetic; Solanum},
	month = {Aug},
	number = {4},
