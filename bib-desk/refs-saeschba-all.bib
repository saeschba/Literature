	journal = ProcNatlAcadSciUSA,
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {HLA, MHC, human evolution, human populations, heterozygote excess, balancing selection},
	number = {23},
	pages = {12452--12456},
	publication-type = {J},
	times-cited = {38},
	title = {Strong balancing selection at {HLA} loci: {E}vidence from segregation in {S}outh {A}merindian families},
	volume = {94},
	year = {1997}}

