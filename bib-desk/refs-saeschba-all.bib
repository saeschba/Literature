	month = {04},
	number = {4},
	pages = {485--495},
	publisher = {Cold Spring Harbor Laboratory Press},
	title = {The recombination landscape of the zebra finch \emph{{Taeniopygia guttata}} genome},
	ty = {JOUR},
	u1 = {20357052{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC2847751/},
