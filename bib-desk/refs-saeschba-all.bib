	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {DNA damage pattern, Neandertal},
	mesh = {Bacteriophage T4; Base Sequence; Computer Simulation; Cytosine; DNA; DNA Damage; DNA-Directed DNA Polymerase; Deamination; Genome; Genomic Library; History, Ancient; Humans; Likelihood Functions; Models, Biological; Molecular Sequence Data; Paleontology; Polymerase Chain Reaction; Reference Standards; Sequence Analysis, DNA; Templates, Genetic},
	month = {Sep},
	number = {37},
