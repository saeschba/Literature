	journal = Science,
	journal_long = {Science},
	keywords = {human evolution, population structure, ancient DNA, anatomically modern humans, human fossils, Mesolithicum, hunter-gatherers, Siberia, Europe, Kostenki, Eurasia, Neandertals},
	title = {Genomic structure in Europeans dating back at least 36,200 years},
