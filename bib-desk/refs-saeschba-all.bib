	journal_long = {Trends in Ecology \& Evolution},
	keywords = {Bateson--Dobzhansky--Muller incompatibility; adaptive introgression; haplodiploidy; hybridization; population genomics},
	mesh = {Animals; Diploidy; Female; Genomics; Haploidy; Hybridization, Genetic; Male},
	month = {Jan},
	number = {1},
	pages = {34--42},
	pmid = {31703819},
	pst = {ppublish},
	title = {Understanding Admixture: Haplodiploidy to the Rescue},
	url = {https://doi.org/10.1016/j.tree.2019.08.013},
	volume = {35},
