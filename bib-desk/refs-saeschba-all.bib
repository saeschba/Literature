@article{Rao:2011aa,
	abstract = {Starting from the early decades of the twentieth century, evolutionary biology began to acquire mathematical overtones. This took place via the development of a set of models in which the Darwinian picture of evolution was shown to be consistent with the laws of heredity discovered by Mendel. The models, which came to be elaborated over the years, define a field of study known as population genetics. Population genetics is generally looked upon as an essential component of modern evolutionary theory. This article deals with a famous dispute between J. B. S. Haldane, one of the founders of population genetics, and Ernst Mayr, a major contributor to the way we understand evolution. The philosophical undercurrents of the dispute remain relevant today. Mayr and Haldane agreed that genetics provided a broad explanatory framework for explaining how evolution took place but differed over the relevance of the mathematical models that sought to underpin that framework. The dispute began with a fundamental issue raised by Mayr in 1959: in terms of understanding evolution, did population genetics contribute anything beyond the obvious? Haldane's response came just before his death in 1964. It contained a spirited defense, not just of population genetics, but also of the motivations that lie behind mathematical modelling in biology. While the difference of opinion persisted and was not glossed over, the two continued to maintain cordial personal relations.},
	author = {Rao, Veena and Nanjundiah, Vidyanand},
	date-added = {2023-04-18 11:12:46 +0200},
	date-modified = {2023-04-18 11:13:33 +0200},
	doi = {10.1007/s10739-010-9229-5},
	journal = JHistBiol,
	journal-full = {Journal of the history of biology},
	journal_long = {Journal of the History of Biology},
	keywords = {beanbag genetics, history of science},
	mesh = {Biological Evolution; Genetics, Population; History, 20th Century; Humans; India; Models, Genetic; United States},
	number = {2},
	pages = {233--281},
	pmid = {20665094},
	pst = {ppublish},
	title = {J. B. S. Haldane, Ernst Mayr and the Beanbag genetics dispute},
	url = {https://doi.org/10.1007/s10739-010-9229-5},
	volume = {44},
	year = {2011},
	bdsk-url-1 = {https://doi.org/10.1007/s10739-010-9229-5}}

