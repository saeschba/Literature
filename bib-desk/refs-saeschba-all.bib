	number = {16},
	pages = {e2220261120},
	pmc = {PMC10120012},
	pmid = {37040419},
	pst = {ppublish},
	title = {Genetic factors predict hybrid formation in the {B}ritish flora},
	url = {https://doi.org/10.1073/pnas.2220261120},
