	jstor_formatteddate = {Sep., 1967},
	keywords = {two-locus model, recombination, linkage, multi-type branching process, survival probability},
	language = {English},
	number = {3},
	pages = {532--540},
	publisher = {Society for the Study of Evolution},
	title = {The probability of fixation of a mutant: The two-locus case},
