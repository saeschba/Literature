	journal = RussJGenet,
	journal_long = {Russian Journal of Genetics},
	keywords = {phylogenetics, Capra, Bovidae, Artiodactyla, mtDNA},
	number = {2},
	pages = {181--189},
	publisher = {MAIK Nauka/Interperiodica distributed exclusively by Springer Science+Business Media LLC.},
	title = {Phylogenetic reconstructions in the genus \emph{{C}apra} ({B}ovidae, {A}rtiodactyla) based on the mitochondrial {DNA} analysis},
	ty = {JOUR},
