	doi = {10.1093/jhered/esh074},
	journal = JHered,
	journal-full = {The Journal of heredity},
	journal_long = {Journal of Heredity},
	keywords = {genetic assignment, population structure, multilocus genotypes, microsatellites, first-generation migrant detection},
	mesh = {Genetics; Genetics, Population; Probability; Software},
	number = {6},
	pages = {536--539},
	pmid = {15475402},
	pst = {ppublish},
	title = {{GENECLASS2}: a software for genetic assignment and first-generation migrant detection},
	url = {https:/doi.org/10.1093/jhered/esh074},
	volume = {95},
	year = {2004},
	bdsk-url-1 = {https://doi.org/10.1093/jhered/esh074},
