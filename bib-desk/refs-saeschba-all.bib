@article{Bourne:2006uk,
	abstract = {The rules for getting articles published included advice on becoming a reviewer early in your career. If you followed that advice, by working through your mentors who will ask you to review, you will then hopefully find these Ten Rules for Reviewers helpful. There is no magic formula for what constitutes a good or a bad paper---the majority of papers fall in between---so what do you look for as a reviewer? We would suggest, above all else, you are looking for what the journal you are reviewing for prides itself on. Scientific novelty---there is just too much ``me-too'' in scientific papers---is often the prerequisite, but not always. There is certainly a place for papers that, for example, support existing hypotheses, or provide a new or modified interpretation of an existing finding. After journal scope, it comes down to a well-presented argument and everything else described in ``Ten Simple Rules for Getting Published'' [1]. Once you know what to look for in a paper, the following simple reviewer guidelines we hope will be useful. Certainly (as with all PLoS Computational Biology material) we invite readers to use the PLoS eLetters feature to suggest their own rules and comments on this important subject.},
	author = {Bourne, Philip E and Korngreen, Alon},
	date-added = {2018-10-07 14:13:23 +0200},
	date-modified = {2018-10-07 14:14:22 +0200},
	doi = {10.1371/journal.pcbi.0020110},
	journal = PLoSComputBiol,
