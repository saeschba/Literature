	keywords = {Herbarium; Other; Phytophthora infestans; Solanum tuberosum; ancient DNA, Irish potato famine, Irish Great Famine, US-1, HERB-1},
	mesh = {DNA, Mitochondrial; Genes, Fungal; Haplotypes; Humans; Ireland; Phytophthora infestans; Solanum tuberosum; Starvation},
	month = {May},
