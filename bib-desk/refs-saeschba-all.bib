	date-modified = {2013-02-27 11:12:08 +0000},
	id = {S0168-9525(11)00062-X DOI - 10.1016/j.tig.2011.05.001},
	isbn = {0168-9525},
	journal = TrendsGenet,
	journal1 = {Trends in genetics : TIG},
	journal2 = {Trends Genet},
	journal_long = {Trends in Genetics},
	keywords = {sex chromosomes, sex-determining region, pseudo-autosomal region, evolutionary dynamics, review},
	month = {09},
