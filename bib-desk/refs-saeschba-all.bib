	journal = Science,
	journal-full = {Science (New York, N.Y.)},
	journal_long = {Science},
	keywords = {population size, genetic variation, population isolation, translocations, conservation genetics, birds, greater prairie chicken},
	month = {Nov},
	number = {5394},
	pages = {1695--1698},
	pmid = {9831558},
	pst = {ppublish},
	title = {Tracking the long-term decline and recovery of an isolated population},
	url = {https://doi.org/10.1126/science.282.5394.1695},
