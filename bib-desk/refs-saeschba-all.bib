	journal_long = {PLoS Biology},
	keywords = {birds, sexual selection, climate, ecology, latitudinal trends},
	mesh = {Animals; Birds; Sexual Selection; Male; Climate; Female; Phylogeny; Biological Evolution; Mating Preference, Animal; Reproduction; Sexual Behavior, Animal; Ecology; Seasons},
	month = {Nov},
	monthly-review = {1},
	number = {11},
	pages = {e3002856},
	pmc = {PMC11567637},
	pmid = {39495808},
	pst = {epublish},
	title = {Climate and ecology predict latitudinal trends in sexual selection inferred from avian mating systems},
	url = {https://doi.org/10.1371/journal.pbio.3002856},
