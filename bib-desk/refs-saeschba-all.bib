	journal = Genetics,
	journal-full = {Genetics},
	journal_long = {Genetics},
	keywords = {genomic relationship matrix (GRM); linkage disequilibrium; local identity by descent (IBD); locus weighting; realized kinship},
	mesh = {Algorithms; Animals; Genome-Wide Association Study; Genotype; Humans; Linkage Disequilibrium; Models, Genetic; Pedigree; Polymorphism, Single Nucleotide},
	month = {03},
	number = {3},
	pages = {1063--1078},
	pmc = {PMC5340323},
	pmid = {28100587},
	pst = {ppublish},
	title = {Efficient Estimation of Realized Kinship from Single Nucleotide Polymorphism Genotypes},
	volume = {205},
	year = {2017},
	bdsk-url-1 = {https://doi.org/10.1534/genetics.116.197004}}

@article{Zhou:2020wu,
	abstract = {Segments of identity by descent (IBD) are used in many genetic analyses. We present a method for detecting identical-by-descent haplotype segments in phased genotype data. Our method, called hap-IBD, combines a compressed representation of haplotype data, the positional Burrows-Wheeler transform, and multi-threaded execution to produce very fast analysis times. An attractive feature of hap-IBD is its simplicity: the input parameters clearly and precisely define the IBD segments that are reported, so that program correctness can be confirmed by users. We evaluate hap-IBD and four state-of-the-art IBD segment detection methods (GERMLINE, iLASH, RaPID, and TRUFFLE) using UK Biobank chromosome 20 data and simulated sequence data. We show that hap-IBD detects IBD segments faster and more accurately than competing methods, and that hap-IBD is the only method that can rapidly and accurately detect short 2-4 centiMorgan (cM) IBD segments in the full UK Biobank data. Analysis of 485,346 UK Biobank samples through the use of hap-IBD with 12 computational threads detects 231.5 billion autosomal IBD segments with length ≥2 cM in 24.4 h.},
	author = {Zhou, Ying and Browning, Sharon R and Browning, Brian L},
	date-added = {2021-11-28 11:49:25 +0100},
	date-modified = {2021-11-28 11:49:36 +0100},
	doi = {10.1016/j.ajhg.2020.02.010},
	journal = {AmJHumGenet},
	journal-full = {American journal of human genetics},
	keywords = {UK Biobank; haplotype; identity by descent},
	mesh = {Alleles; Chromosomes; Computer Simulation; Data Analysis; Genetic Markers; Genetics, Population; Genome, Human; Genotype; Haplotypes; Humans; Polymorphism, Single Nucleotide; Sequence Analysis, DNA; Software},
	month = {04},
	number = {4},
	pages = {426--437},
	pmc = {PMC7118582},
	pmid = {32169169},
	pst = {ppublish},
	title = {A Fast and Simple Method for Detecting Identity-by-Descent Segments in Large-Scale Data},
	volume = {106},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1016/j.ajhg.2020.02.010}}

@article{Wang:2021tm,
	abstract = {BACKGROUND: We present ARCHes, a fast and accurate haplotype-based approach for inferring an individual's ancestry composition. Our approach works by modeling haplotype diversity from a large, admixed cohort of hundreds of thousands, then annotating those models with population information from reference panels of known ancestry.
RESULTS: The running time of ARCHes does not depend on the size of a reference panel because training and testing are separate processes, and the inferred population-annotated haplotype models can be written to disk and reused to label large test sets in parallel (in our experiments, it averages less than one minute to assign ancestry from 32 populations using 10 CPU). We test ARCHes on public data from the 1000 Genomes Project and the Human Genome Diversity Project (HGDP) as well as simulated examples of known admixture.
CONCLUSIONS: Our results demonstrate that ARCHes outperforms RFMix at correctly assigning both global and local ancestry at finer population scales regardless of the amount of population admixture.},
	author = {Wang, Yong and Song, Shiya and Schraiber, Joshua G and Sedghifar, Alisa and Byrnes, Jake K and Turissini, David A and Hong, Eurie L and Ball, Catherine A and Noto, Keith},
	date-added = {2021-11-28 11:36:54 +0100},
