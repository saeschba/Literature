	journal = Science,
	journal_long = {Science},
	keywords = {reproductive isolation, speciation, salmon},
	number = {5491},
	pages = {516--518},
	title = {Rapid Evolution of Reproductive Isolation in the Wild: Evidence from Introduced Salmon},
