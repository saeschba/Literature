	month = {2022/07/25/},
	number = {3},
	pages = {335--338},
	publisher = {Kansas (Central States) Entomological Society},
	title = {Notes on the Seasonality, Geographic Distribution, and Floral Preferences of the Bee Alocandrena porteri (Hymenoptera: Andrenidae)},
