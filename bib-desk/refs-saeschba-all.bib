	keywords = {crop loss, drought damage, epidemics, famine, financial crisis, pauperism, potato, Phytophthora infestans},
	number = {1},
	pages = {5--45},
	title = {The Potato Murrain on the European Continent and the Revolutions of 1848},
	ty = {JOUR},
	url = {https://doi.org/10.1007/s11540-008-9091-4},
	volume = {51},
	year = {2008},
	bdsk-url-1 = {https://doi.org/10.1007/s11540-008-9091-4}}

