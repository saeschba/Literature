	journal_long = {American Journal of Human Genetics},
	keywords = {GWAS; PGS; autoimmune diseases; biobank studies; cross-biobank analysis; ensemble learning; genetic risk; genetic variability; genome-wide association studies; method evaluation; phenotype prediction; polygenic scores},
	mesh = {Humans; Multifactorial Inheritance; Genome-Wide Association Study; Biological Specimen Banks; Phenotype; Diabetes Mellitus, Type 1; Polymorphism, Single Nucleotide; Machine Learning},
	month = {Jul},
	monthly-pick = {Pick},
	monthly-review = {1},
	number = {7},
	pages = {1431--1447},
	pmid = {38908374},
	pst = {ppublish},
	title = {Evaluation of polygenic scoring methods in five biobanks shows larger variation between biobanks than methods and finds benefits of ensemble learning},
	url = {https://doi.org/10.1016/j.ajhg.2024.06.003},
