	journal_long = {Biological Reviews of the Cambridge Philosophical Society},
	jt = {Biological reviews of the Cambridge Philosophical Society},
	keywords = {biological collections, museum, herbarium, ecology, environment, potential for research, limitations},
	language = {eng},
	lid = {10.1111/j.1469-185X.2009.00098.x {$[$}doi{$]$}},
	lr = {20100528},
	mh = {Animals; *Archives; *Ecology; *Environment; *Plants},
