	doi = {10.1016/j.ajhg.2024.11.012},
	journal = AmJHumGenet,
	journal-full = {American journal of human genetics},
	journal_long = {American Journal of Human Genetics},
	keywords = {DNA methylation; epigenetic scores; epigenome-wide association studies; general cognitive function; metabolic traits},
	mesh = {Humans; Singapore; Scotland; DNA Methylation; Body Mass Index; Female; Male; Genome-Wide Association Study; Cohort Studies; Middle Aged; Epigenesis, Genetic; Aged; Adult; Waist-Hip Ratio; Bayes Theorem; Epigenome},
	month = {Jan},
