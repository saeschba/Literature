	journal_long = {American Journal of Human Genetics},
	keywords = {change of management; clinical genome testing; clinical utility; diagnostic equity; genetic testing; low- and middle-income; rare disease; rare genetic disease; whole-genome sequencing},
	mesh = {Humans; Male; Rare Diseases; Female; Child; Genetic Testing; Whole Genome Sequencing; Child, Preschool; Adolescent; Adult; Infant; Genetic Diseases, Inborn},
	month = {Jul},
