	journal = NewPhytol,
	journal-full = {The New phytologist},
	journal_long = {New Phytologist},
	keywords = {Solanum habrochaites ; intrapopulation reproductive barrier; mating system transition; pollen-pistil interactions; self-compatibility; self-incompatibility; wild tomato species},
	mesh = {Flowers; Peru; Pollen; Ribonucleases; Self-Incompatibility in Flowering Plants; Solanum},
	month = {07},
	number = {2},
	pages = {878--891},
	pmid = {33864700},
	pst = {ppublish},
	title = {Spread of self-compatibility constrained by an intrapopulation crossing barrier},
	volume = {231},
	year = {2021},
	bdsk-url-1 = {https://doi.org/10.1111/nph.17400}}

