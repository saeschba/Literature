@article{Bodenes:2016fj,
	annote = {10.1093/dnares/dsw001},
	author = {Bod\'{e}n\`{e}s, Catherine and Chancerel, Emilie and Ehrenmann, Fran\c{}ois and Kremer, Antoine and Plomion, Christophe},
	date = {2016/03/23},
	date-added = {2016-06-12 20:35:36 +0000},
	date-modified = {2016-06-12 20:37:39 +0000},
	journal = {DNARes},
	journal1 = {DNA Research},
	journal_long = {DNA Research},
	keywords = {linkage map, oak, Quercus},
	month = {03},
	n2 = {We developed the densest single-nucleotide polymorphism (SNP)-based linkage genetic map to date for the genus Quercus. An 8k gene-based SNP array was used to genotype more than 1,000 full-sibs from two intraspecific and two interspecific full-sib families of Quercus petraea and Quercus robur. A high degree of collinearity was observed between the eight parental maps of the two species. A composite map was then established with 4,261 SNP markers spanning 742 cM over the 12 linkage groups (LGs) of the oak genome. Nine genomic regions from six LGs displayed highly significant distortions of segregation. Two main hypotheses concerning the mechanisms underlying segregation distortion are discussed: genetic load vs. reproductive barriers. Our findings suggest a predominance of pre-zygotic to post-zygotic barriers.},
	title = {High-density linkage mapping and distribution of segregation distortion regions in the oak genome},
	ty = {JOUR},
	url = {http://dnaresearch.oxfordjournals.org/content/early/2016/03/23/dnares.dsw001.abstract},
	year = {2016},
	bdsk-url-1 = {http://dnaresearch.oxfordjournals.org/content/early/2016/03/23/dnares.dsw001.abstract}}

