	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {EPAS1; Tibetan sheep; genomic structural variation; high-altitude adaptation; hypoxia},
	mesh = {Animals; Altitude; Sheep; Tibet; Genomic Structural Variation; Basic Helix-Loop-Helix Transcription Factors; Gene Expression Regulation; Genome; Acclimatization},
	month = {Jul},
