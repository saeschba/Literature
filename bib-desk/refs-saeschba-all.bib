@article{Bulmer:1971wq,
	abstract = {In their well known study of protein polymorphism in Drosophila pseudoobscura, Prakash, Lewontin and Hubby (1969) showed that most loci reveal little or no differentiation in allele frequencies in different sub-populations; they concluded that the observed polymorphism cannot be due to random genetic drift of neutral mutations and are most likely to be caused by some form of balancing selection [...] The purpose of this letter is to point out another feature of the data of Prakash et al. (1969) which suggests that the polymorphic alleles are not selectively neutral.},
