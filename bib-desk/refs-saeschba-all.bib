	doi = {10.1086/380606},
	isbn = {00030147},
	journal = AmNat,
	journal_long = {The American Naturalist},
	keywords = {domestication, recombination, preadaptation, chiasma frequency},
	m1 = {ArticleType: research-article / Full publication date: January 2004 / Copyright {\copyright}2004 The University of Chicago},
	month = {01},
	number = {1},
	pages = {105--112},
	publisher = {The University of Chicago Press for The American Society of Naturalists},
	title = {The Evolution of Recombination under Domestication: A Test of Two Hypotheses.},
	ty = {JOUR},
	url = {http://www.jstor.org/stable/10.1086/380606},
	volume = {163},
	year = {2004},
