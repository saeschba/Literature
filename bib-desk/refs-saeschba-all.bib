	keywords = {tomato, Solanum lycopersicum, cold tolerance, WRKY34, domestication},
	mesh = {Solanum lycopersicum; Promoter Regions, Genetic; Gene Expression Regulation, Plant; Plant Proteins; Transcription Factors; Cold Temperature; Cold-Shock Response; Chromatin; Evolution, Molecular},
	month = {Aug},
	number = {1},
	pages = {6667},
	pmc = {PMC11303406},
	pmid = {39107290},
	pst = {epublish},
	title = {Loss of cold tolerance is conferred by absence of the {WRKY34} promoter fragment during tomato evolution},
	url = {https://doi.org/10.1038/s41467-024-51036-y},
	volume = {15},
	year = {2024},
