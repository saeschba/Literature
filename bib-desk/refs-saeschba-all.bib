	number = {10},
	pages = {4007--4014},
	pmc = {PMC106592},
	pmid = {9758833},
	pst = {ppublish},
	title = {Polymorphisms in phytophthora infestans: four mitochondrial haplotypes are detected after {PCR} amplification of {DNA} from pure cultures or from host lesions},
	url = {https://doi.org/10.1128/AEM.64.10.4007-4014.1998},
