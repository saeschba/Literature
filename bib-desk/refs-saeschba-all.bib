	keywords = {S. pimpinellifolium ; crossover recombination; gene conversion; recombination bin mapping; recombination cold spots; recombination hot spots; tomato},
	mesh = {5' Untranslated Regions; Chromosomes, Plant; Crossing Over, Genetic; Genome, Plant; Genotype; Solanum lycopersicum; Meiosis; Promoter Regions, Genetic; Sequence Analysis, DNA},
	month = {May},
	number = {3},
	pages = {480-492},
	pmid = {31820490},
	pst = {ppublish},
	title = {Meiotic recombination profiling of interspecific hybrid {F}1 tomato pollen by linked read sequencing},
