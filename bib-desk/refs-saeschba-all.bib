@article{Crow:1989xg,
	abstract = {A genetic interpretation of isonymy and isonymous marriages was introduced almost a quarter century ago (Crow and Mange 1965). The technique has since been widely used and extended to a variety of new applications. This is evidenced by two symposia in connection with meetings of the Human Biology Council and the American Association of Physical Anthropologists (Gottlieb 1983) and by a book (Lasker 1985) devoted to this subject. Not surprisingly, the simple idea of using names to study populations is an old one and has been independently thought of several times. Lasker (1985) has provided a brief but informative history.},
