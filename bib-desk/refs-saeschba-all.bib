	journal_long = {Genes Genomes Genetics},
	keywords = {C language; R package; breeding program design; breeding program simulation; genomic selection; meiosis simulation},
	mesh = {Computer Simulation; Genomics; Genotype; Software},
	month = {Sep},
	number = {10},
	pmc = {PMC9526041},
	pmid = {36053200},
	pst = {ppublish},
	title = {{genomicSimulation}: fast {R} functions for stochastic simulation of breeding programs},
	volume = {12},
	year = {2022},
	bdsk-url-1 = {https://doi.org/10.1093/g3journal/jkac216}}

@article{Darroch:2022aa,
	abstract = {Geographic ranges are a fundamental unit of biogeography and macroecology. Increasingly, paleontologists and ecologists alike are reconstructing geographic ranges of species from fossils, in order to understand the long-term processes governing biogeographic and macroevolutionary patterns. As these reconstructions have become increasingly common, uncertainty has arisen over the equivalency of paleo-ranges and modern ranges. Here, we argue geographic ranges are time-averaged at all temporal scales, and reflect the biotic and abiotic processes operating across the equivalent range of time and space scales. This conceptual framework integrates the study of geographic ranges reconstructed using modern and ancient data, and highlights the potential for ranges to illuminate processes responsible for diversity patterns over intervals spanning days to tens of millions of years of Earth history.},
	author = {Darroch, Simon A F and Saupe, Erin E and Casey, Michelle M and Jorge, Maria L S P},
	date-added = {2022-11-06 17:37:50 +0100},
	date-modified = {2022-11-06 17:38:09 +0100},
