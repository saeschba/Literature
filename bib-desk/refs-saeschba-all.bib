	doi = {10.1007/s00299-024-03333-5},
	journal = PlantCellRep,
	journal-full = {Plant cell reports},
	journal_long = {Plant Cell Reports},
	keywords = {Abscisic acid; Drought stress; Reactive oxygen species; SlWOX4 transcription factor; Tomato},
	mesh = {Solanum lycopersicum; Plant Proteins; Gene Expression Regulation, Plant; Droughts; Abscisic Acid; Plants, Genetically Modified; Transcription Factors; Stress, Physiological; Reactive Oxygen Species; Gene Editing; Homeodomain Proteins; CRISPR-Cas Systems; Drought Resistance},
	month = {Oct},
	number = {11},
	pages = {253},
	pmid = {39370470},
	pst = {epublish},
	title = {A {WUSCHEL}-related homeobox transcription factor, {SlWOX4}, negatively regulates drought tolerance in tomato},
	url = {https://doi.org/10.1007/s00299-024-03333-5},
	volume = {43},
	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1007/s00299-024-03333-5}}

@article{Zhang:2024af,
	abstract = {In tomato, sugar content is highly correlated with consumer preferences, with most consumers preferring sweeter fruit1-4. However, the sugar content of commercial varieties is generally low, as it is inversely correlated with fruit size, and growers prioritize yield over flavour quality5-7. Here we identified two genes, tomato (Solanum lycopersicum) calcium-dependent protein kinase 27 (SlCDPK27; also known as SlCPK27) and its paralogue SlCDPK26, that control fruit sugar content. They act as sugar brakes by phosphorylating a sucrose synthase, which promotes degradation of the sucrose synthase. Gene-edited SlCDPK27 and SlCDPK26 knockouts increased glucose and fructose contents by up to 30%, enhancing perceived sweetness without fruit weight or yield penalty. Although there are fewer, lighter seeds in the mutants, they exhibit normal germination. Together, these findings provide insight into the regulatory mechanisms controlling fruit sugar accumulation in tomato and offer opportunities to increase sugar content in large-fruited cultivars without sacrificing size and yield.},
	author = {Zhang, Jinzhe and Lyu, Hongjun and Chen, Jie and Cao, Xue and Du, Ran and Ma, Liang and Wang, Nan and Zhu, Zhiguo and Rao, Jianglei and Wang, Jie and Zhong, Kui and Lyu, Yaqing and Wang, Yanling and Lin, Tao and Zhou, Yao and Zhou, Yongfeng and Zhu, Guangtao and Fei, Zhangjun and Klee, Harry and Huang, Sanwen},
	date-added = {2025-02-03 08:17:39 +0100},
