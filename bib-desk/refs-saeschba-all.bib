@article{Rousset:1997fu,
	abstract = {Several methods or tests and various software are currently being developed for analyzing data in population genetics and ecology, which often rely on computer-intensive algorithms. The potential user is thus confronted with the painful experience of freedom and, in particular, has to make a priori choices between different methods. Using examples drawn from population genetics, we explain some of these recently developed tools.},
