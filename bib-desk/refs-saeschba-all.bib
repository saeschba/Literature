@article{Eshel:1981kx,
	abstract = {A branching process method is employed to study the survival probability of a slightly advantageous mutant gene with a general distribution of progeny size in a large population. A counter-example to a classic proposition is given. A somewhat weaker result is proved.},
	annote = {Instead of assuming a Poisson number of offspring, a general distribution is considered. The widely accepted approximation 1-u= 2s/sigma^2 + o(s), where u is the probab. of extinction, is shown to be mathematically invalid. However, it is proved to be valid for a rather rich set of families of progeny distributions. And, even though mathematically incorrect, may be accepted for most conceivable biological situations.

Comment: Understanding why the approximation is mathematically incorrect may nevertheless be worthwhile.

Notice: The results given here are later improved on by Athreya:1993ve.},
	author = {Eshel, Ilan},
	date-added = {2011-12-05 07:26:10 +0000},
	date-modified = {2011-12-05 09:07:21 +0000},
	issn = {0303-6812},
	issue = {3},
	journal = JMathBiol,
	journal_long = {Journal of Mathematical Biology},
	keyword = {Biomedical and Life Sciences},
	keywords = {branching process, mutation, extinction, progeny size, survival probability, general offspring distribution},
	note = {10.1007/BF00276922},
	pages = {355-362},
	publisher = {Springer Berlin / Heidelberg},
	title = {On the survival probability of a slightly advantageous mutant gene with a general distribution of progeny size---A branching process model},
