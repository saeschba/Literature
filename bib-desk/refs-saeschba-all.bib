	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {Andes; Phyllotis; high altitude; hypoxia; range limits},
	month = {Aug},
	number = {31},
	pages = {18169--18171},
	pmc = {PMC7414144},
	pmid = {32675238},
	pst = {ppublish},
	title = {Discovery of the world's highest-dwelling mammal},
	volume = {117},
	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1073/pnas.2005265117}}

