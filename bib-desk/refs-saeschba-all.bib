	keywords = {pool-seq, next-generation sequencing},
	mesh = {DNA; Gene Frequency; Genetic Markers; Genomics; Haplotypes; High-Throughput Nucleotide Sequencing; Polymorphism, Single Nucleotide; Sequence Analysis, DNA},
	month = {Sep},
	number = {1},
