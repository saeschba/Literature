	doi = {10.1016/j.tree.2023.10.012},
	journal = TrendsEcolEvol,
	journal-full = {Trends in ecology \& evolution},
	journal_long = {Trends in Ecology \& Evolution},
	keywords = {modelling; parameter; propagation; uncertainty},
	month = {Nov},
	number = {4},
	pages = {328--337},
	pmid = {38030538},
	pst = {aheadofprint},
	title = {Recommendations for quantitative uncertainty consideration in ecology and evolution},
	url = {https://doi.org/10.1016/j.tree.2023.10.012},
	volume = {39},
