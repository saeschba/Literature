	bdsk-url-1 = {https://doi.org/10.1073/pnas.2322291121}}

@article{Sonter:2024aa,
	abstract = {Renewable energy projects, such as wind farms and hydropower dams, can indirectly benefit biodiversity by mitigating climate change. However, we explain why such indirect benefits should not contribute towards the accounting of project-level net biodiversity outcomes and provide guidance on the steps needed to legitimately claim no-net-loss of biodiversity.},
