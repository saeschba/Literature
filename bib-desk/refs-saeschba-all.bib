	keywords = {quantitative trait mapping, Drosophila melanogaster, selection},
	number = {02},
	pages = {79--91 M3 - null},
	publisher = {Cambridge Journals Online},
	title = {Mapping quantitative trait loci affecting sternopleural bristle number in \emph{Drosophila melanogaster} using changes of marker allele frequencies in divergently selected lines},
	ty = {JOUR},
	url = {http://journals.cambridge.org/action/displayAbstract?fromPage=online&aid=3515&fulltextType=RA&fileId=S001667239800336X},
	volume = {72},
