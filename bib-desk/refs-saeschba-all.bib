	doi = {10.1111/tpj.15770},
	journal = PlantJ,
	journal-full = {The Plant journal : for cell and molecular biology},
	journal_long = {The Plant Journal},
	keywords = {Solanum lycopersicoides; anthocyanin; carotenoids; disease resistance; drought; genome},
	mesh = {Anthocyanins; Chromosomes, Plant; Lycopersicon esculentum; Plant Breeding; Solanum},
	month = {06},
