	doi = {10.1038/nrg2664},
	isbn = {1471-0056},
	journal = NatRevGenet,
	journal_long = {Nature Review Genetics},
	keywords = {inbreeding depression, review},
	m3 = {10.1038/nrg2664},
	month = {11},
