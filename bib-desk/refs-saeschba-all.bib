	journal = MolBiolEvol,
	journal-full = {Molecular biology and evolution},
	journal_long = {Molecular Biology and Evolution},
	keywords = {S*; Python; archaic admixture; introgression},
	mesh = {Humans; Animals; Genome, Human; Neanderthals; Genetics, Population},
	month = {Nov},
