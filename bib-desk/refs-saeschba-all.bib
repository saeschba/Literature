	journal = TheorPopulBiol,
	journal_long = {Theoretical Population Biology},
	journallong = {Theoretical Population Biology},
	keywords = {Maximum-likelihood estimation, coalescence time, IM model},
	number = {2},
	pages = {277--288},
	title = {The distribution of the coalescence time and the number of pairwise nucleotide differences in the ``isolation with migration'' model},
	url = {http://www.sciencedirect.com/science/article/pii/S0040580907001244},
	volume = {73},
