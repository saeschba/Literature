	journal = TrendsEcolEvol,
	journal-full = {Trends in ecology \& evolution},
	journal_long = {Trends in Ecology & Evolution},
	keywords = {ancient agriculture; archaeobotany; land cover; land use; landscape transformations},
	mesh = {Agriculture; Archaeology; Botany; Humans; Plants},
	month = {Oct},
	number = {10},
