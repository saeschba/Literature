	keywords = {brassinosteroid; calcium-dependent protein kinase; light signal; photomorphogenesis},
	mesh = {Solanum lycopersicum; Brassinosteroids; Plant Proteins; Protein Kinases; Gene Expression Regulation, Plant; Light; Phosphorylation; Hypocotyl; Temperature; Morphogenesis},
	month = {Sep},
