	keywords = {biomolecules; extinctions; fallow deer; translocations; zooarchaeology},
	mesh = {Animals; Humans; Deer; Balkan Peninsula},
	month = {Feb},
	monthly-pick = {Pick},
	monthly-rev = {1},
	number = {8},
	pages = {e2310051121},
	pmc = {PMC10895352},
	pmid = {38346198},
	pst = {ppublish},
	title = {The 10,000-year biocultural history of fallow deer and its implications for conservation policy},
	url = {https://doi.org/10.1073/pnas.2310051121},
	volume = {121},
	year = {2024},
