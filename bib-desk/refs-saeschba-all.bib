	doi = {10.1073/pnas.2122734119},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {allele surfing; exome sequencing; invasion biology; population expansion},
	mesh = {Animals; Animals, Domestic; Animals, Wild; Australia; Genetic Variation; Genetics, Population; Genomics; Genotype; History, 19th Century; History, 20th Century; History, 21st Century; Introduced Species; New Zealand; Rabbits; Tasmania; Time Factors},
	month = {Aug},
