	pmid = {34324594},
	pst = {epublish},
	title = {First historical genome of a crop bacterial pathogen from herbarium specimen: Insights into citrus canker emergence},
	url = {https://doi.org/10.1371%2Fjournal.ppat.1009714},
	volume = {17},
