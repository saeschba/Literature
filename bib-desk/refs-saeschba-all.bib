	doi = {10.1016/j.tree.2018.04.006},
	isbn = {0169-5347},
	journal = TrendsEcolEvol,
	journal_long = {Trends in Ecology \& Evolution},
	keywords = {anagenesis, cladogenesis, speciation, island speciation, island biogeography, review, insular sister species},
	m3 = {doi: 10.1016/j.tree.2018.04.006},
	month = {2018/05/07},
	n2 = {Anagenesis and cladogenesis are fundamental evolutionary concepts, but are increasingly being adopted as speciation models in the field of island biogeography. Here, we review the origin of the terms ?anagenetic? and ?cladogenetic? speciation, critique their utility, and finally suggest alternative terminology that better describes the geographical relationships of insular sister species.},
	publisher = {Elsevier},
	title = {Anagenesis, Cladogenesis, and Speciation on Islands},
	ty = {JOUR},
