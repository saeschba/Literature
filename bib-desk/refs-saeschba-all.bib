	keywords = {Alzheimer's disease, amyloid, anti-amyloid therapy, disease modification, clinical trial, intravenous antibodies},
	mesh = {Alzheimer Disease; Amyloid; Amyloid beta-Peptides; Amyloidosis; Brain; Cognitive Dysfunction; Humans},
