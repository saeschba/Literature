	journal = TrendsEcolEvol,
	journal_long = {Trends in Ecology \& Evolution},
	keywords = {ABC, review},
	m3 = {doi: DOI: 10.1016/j.tree.2010.04.001},
	month = {7},
	number = {7},
	pages = {410--418},
	title = {Approximate {B}ayesian Computation ({ABC}) in practice},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/B6VJ1-503WMFS-1/2/64bcd19f311b55ad28dc6bc889caad6d},
