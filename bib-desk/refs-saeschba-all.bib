	fu = {Swedish Foundation for International Cooperation in Research and Higher Education (STINT) ; Swedish Research Council ; Erik Philip-Sorensen's foundation},
	fx = {This work was supported by a grant from the Swedish Foundation for International Cooperation in Research and Higher Education (STINT) to Mattias Jakobsson and Michael G. B. Blum. Mattias Jakobsson would like to thank the Swedish Research Council and the Erik Philip-Sorensen's foundation for financial support.},
	isi = {ISI:000287112300003},
	isi-document-delivery-number = {718HS},
