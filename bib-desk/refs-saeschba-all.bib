	date-added = {2008-06-30 09:00:48 +0100},
	date-modified = {2008-08-18 12:44:45 +0100},
	journal = Bioinformatics,
	journal1 = {Bioinformatics},
	keywords = {individual-based, simulation, selection, mutation, recombination, genetic drift, quantitative traits, structured populations, migration, heterogeneous habitat},
