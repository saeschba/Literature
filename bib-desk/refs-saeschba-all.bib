	journal = NatEcolEvol,
	journal-full = {Nature ecology \& evolution},
	journal_long = {Nature Ecology and Evolution},
	keywords = {forest disturbance, habitat suitability, ungulates, red deer, roe deer, European bison, moose},
	mesh = {Animals; Herbivory; Forests; Europe; Deer; Ecosystem; Forestry; Conservation of Natural Resources; Bison},
