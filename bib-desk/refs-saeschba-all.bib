@article{Wang:1999tx,
	abstract = {The effective population size is the parameter that summarizes the magnitude of genetic drift and increase in inbreeding occurring in a population. In this pager, developments in the prediction equations for the effective size of populations subdivided under various models are reviewed, and extensions are made in several cases. Derivations are shown for some simple models, and the relationships among these equations and with these for a single unsubdivided population are discussed. The effect of population subdivision on neutral genetic variation and its implications are explained.},
