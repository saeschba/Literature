	year = {2020},
	bdsk-url-1 = {https://doi.org/10.1007/978-1-0716-0199-0_4}}

@inbook{Chang:2020aa,
	abstract = {PLINK is a versatile program which supports data management, quality control, and common statistical computations on matrices of genomic variant calls, in a computationally efficient manner. In population genomics, it is frequently used to take care of the ``basics,'' so they do not need to be reimplemented when a new type of analysis needs to be performed on such a matrix. I describe several of these basic operations, and discuss uses and pitfalls.},
