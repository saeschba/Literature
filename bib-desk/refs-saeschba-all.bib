@article{Wakeley:1996uq,
	abstract = {A number of different migration and isolation models of population subdivision have been studied. In this paper I analyse a general model of two populations derived From a common ancestral population at some time in the past. The two populations may exchange migrants, bur they map also be completely isolated from each other. I derive the expectation and variance of the number of differences between two sequences sampled from the two populations. These are then compared to the corresponding results from two other much-used models: equilibrium migration and complete isolation. },
