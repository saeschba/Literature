	journal = ProcNatlAcadSciUSA,
	journal_long = {Proceedings of the National Academy of Sciences},
	keywords = {stabilising selection, two-locus model, dominance, linkage, inbreeding, heterozygote advantage, multilocus models, maintenance of genetic variation, panmixia},
	number = {5},
	pages = {1436-1443},
	title = {The nature and stability of equilibria under optimizing selection},
	url = {http://www.pnas.org/content/54/5/1436.short},
	volume = {54},
