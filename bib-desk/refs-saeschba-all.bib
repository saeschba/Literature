@article{Faith:2021aa,
	abstract = {A central goal of paleoanthropology is understanding the role of ecological change in hominin evolution. Over the past several decades researchers have expanded the hominin fossil record and assembled detailed late Cenozoic paleoclimatic, paleoenvironmental, and paleoecological archives. However, effective use of these data is precluded by the limitations of pattern-matching strategies for inferring causal relationships between ecological and evolutionary change. We examine several obstacles that have hindered progress, and highlight recent research that is addressing them by (i) confronting an incomplete fossil record, (ii) contending with datasets spanning varied spatiotemporal scales, and (iii) using theoretical frameworks to build stronger inferences. Expanding on this work promises to transform challenges into opportunities and set the stage for a new phase of paleoanthropological research.},
	author = {Faith, J Tyler and Du, Andrew and Behrensmeyer, Anna K and Davies, Benjamin and Patterson, David B and Rowan, John and Wood, Bernard},
	date-added = {2023-08-09 21:43:04 +0200},
	date-modified = {2023-08-09 21:43:20 +0200},
	doi = {10.1016/j.tree.2021.04.011},
	journal = TrendsEcolEvol,
	journal-full = {Trends in ecology \& evolution},
	journal_long = {Trends in Ecology & Evolution},
	keywords = {Africa; human evolution; paleoanthropology; paleoecology},
	mesh = {Animals; Biological Evolution; Fossils; Hominidae},
	month = {Sep},
	number = {9},
	pages = {797--807},
	pmid = {34059368},
	pst = {ppublish},
	title = {Rethinking the ecological drivers of hominin evolution},
	url = {https://doi.org/10.1016/j.tree.2021.04.011},
