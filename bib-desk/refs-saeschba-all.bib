	keywords = {locule number, tomato, Solanum lycopersicum, WUSCHEL},
	mesh = {Agriculture; Base Sequence; Evolution, Molecular; Flowers; Gene Expression Regulation, Plant; Genes, Plant; Genetic Association Studies; Solanum lycopersicum; Models, Genetic; Molecular Sequence Data; Organ Size; Phenotype; Physical Chromosome Mapping; Plant Proteins; Polymorphism, Single Nucleotide; Reproducibility of Results; Seeds},
