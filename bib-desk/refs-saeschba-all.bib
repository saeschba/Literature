	isbn = {1527-8204},
	journal = AnnuRevGenomHumGenet,
	keywords = {lineage sorting, phylogenetics, mutation, selection, recombination, concatenation, gene trees, speciation},
	m3 = {doi: 10.1146/annurev.genom.9.081307.164407},
	month = {09},
	number = {1},
	pages = {217--231},
	publisher = {Annual Reviews},
	title = {Phylogenetic Inference Using Whole Genomes},
	ty = {JOUR},
	url = {http://dx.doi.org/10.1146/annurev.genom.9.081307.164407},
	volume = {9},
