	keywords = {ABC, ABC-SMC, Sequential Monte-Carlo, model selection},
	month = {Feb},
	number = {31},
	pages = {187--202},
	publication-type = {J},
	title = {Approximate {B}ayesian computation scheme for parameter inference and model selection in dynamical systems},
