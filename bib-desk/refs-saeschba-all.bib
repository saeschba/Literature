	keywords = {Mendelian disease; association study; penetrance; recessive disease},
	mesh = {Alleles; Antley-Bixler Syndrome Phenotype; Cystic Fibrosis; Databases, Factual; Genetic Predisposition to Disease; Humans; Lung Diseases, Interstitial; Muscular Atrophy, Spinal; Penetrance; Phenotype; United Kingdom},
	month = {Jul},
