@article{Buerger:2011uq,
	abstract = {Population subdivision and migration are generally considered to be important causes of linkage disequilibrium $(LD)$. We explore the combined effects of recombination and gene flow on the amount of $LD$, the maintenance of polymorphism, and the degree of local adaptation in a subdivided population by analyzing a diploid, deterministic continent--island model with genic selection on two linked loci (i.e., no dominance or epistasis). For this simple model, we characterize explicitly all possible equilibrium configurations. Simple and intuitive approximations for many quantities of interest are obtained in limiting cases, such as weak migration, weak selection, weak or strong recombination. For instance, we derive explicit expressions for the measures $D ( = p_{AB} - p_A p_B )$ and $r^2$ (the squared correlation in allelic state) of $LD$. They depend in qualitatively different ways on the migration rate. Remarkably high values of $r^2$ are maintained between weakly linked loci, especially if gene flow is low. We determine how the maximum amount of gene flow that admits preservation of the locally adapted haplotype, hence of polymorphism at both loci, depends on recombination rate and selection coefficients. We also investigate the evolution of differentiation by examining the invasion of beneficial mutants of small effect that are linked to an already present, locally adapted allele. Mutants of much smaller effect can invade successfully than predicted by naive single-locus theory provided they are at least weakly linked. Finally, the influence of linkage on the degree of local adaptation, the migration load, and the effective migration rate at a neutral locus is explored. We discuss possible consequences for the evolution of genetic architecture, in particular, for the emergence of clusters of tightly linked, slightly beneficial mutations and the evolution of recombination and chromosome inversions.},
	author = {B{\"u}rger, Reinhard and Akerman, Ada},
	date-added = {2011-11-05 17:14:20 +0100},
	date-modified = {2022-12-22 15:10:50 +0100},
	isbn = {0040-5809},
	journal = TheorPopulBiol,
	journal_long = {Theoretical Population Biology},
	keywords = {Selection; Migration; Recombination; Linkage disequilibrium; Population subdivision; Genetic architecture},
	m3 = {doi: 10.1016/j.tpb.2011.07.002},
	number = {4},
	pages = {272--288},
	title = {The effects of linkage and gene flow on local adaptation: A two-locus continent--island model},
	ty = {JOUR},
	url = {https://doi.org/10.1016/j.tpb.2011.07.002},
	volume = {80},
	year = {2011},
	bdsk-url-1 = {http://www.sciencedirect.com/science/article/pii/S004058091100061X},
	bdsk-url-2 = {https://doi.org/10.1016/j.tpb.2011.07.002}}

@article{Pfaffelhuber:2006ys,
	abstract = {The rapid fixation of an advantageous allele leads to a reduction in linked neutral variation around the target of selection. The genealogy at a neutral locus in such a selective sweep can be simulated by first generating a random path of the advantageous allele's frequency and then a structured coalescent in this background. Usually the frequency path is approximated by a logistic growth curve. We discuss an alternative method that approximates the genealogy by a random binary splitting tree, a so-called Yule tree that does not require first constructing a frequency path. Compared to the coalescent in a logistic background, this method gives a slightly better approximation for identity by descent during the selective phase and a much better approximation for the number of lineages that stem from the founder of the selective sweep. In applications such as the approximation of the distribution of Tajima's D, the two approximation methods perform equally well. For relevant parameter ranges, the Yule approximation is faster.},
	annote = {10.1534/genetics.106.061887},
	author = {Pfaffelhuber, P. and Haubold, B. and Wakolbinger, A.},
	date-added = {2011-11-04 17:34:40 +0100},
	date-modified = {2013-05-21 14:23:18 +0000},
	journal = Genetics,
	journal1 = {Genetics},
	journal_long = {Genetics},
	keywords = {selective sweep, approximate sampling formula, genealogy, Yule process},
	number = {4},
	pages = {1995--2008},
	title = {Approximate Genealogies Under Genetic Hitchhiking},
	ty = {JOUR},
	url = {http://www.genetics.org/content/174/4/1995.abstract},
	volume = {174},
	year = {2006},
	bdsk-url-1 = {http://www.genetics.org/content/174/4/1995.abstract}}

