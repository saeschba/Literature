	isbn = {00143820},
	journal = Evolution,
	journal_long = {Evolution},
	keywords = {chromosomal inversion, translocation, underdominance, heterozygote disadvantage, genetic drift, fixation probability, population subdivision, extinction, colonisation, Robertsonian fusion},
	m1 = {ArticleType: research-article / Issue Title: Part 1 / Full publication date: Mar., 1979 / Copyright {\copyright}1979 Society for the Study of Evolution},
	month = {03},
	number = {1},
	pages = {234--251},
	publisher = {Society for the Study of Evolution},
	title = {Effective Deme Sizes During Long-Term Evolution Estimated from Rates of Chromosomal Rearrangement},
	ty = {JOUR},
