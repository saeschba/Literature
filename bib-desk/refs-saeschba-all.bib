	j1 = {Am J Hum Genet},
	journal = AmJHumGenet,
	journal_long = {American Journal of Human Genetics},
	keywords = {inbreeding coefficient, IBD, IBS, hidden Markov model, human evolution},
	month = {09},
	number = {3},
	pages = {516--523},
	publisher = {The American Society of Human Genetics},
	title = {Estimation of the Inbreeding Coefficient through Use of Genomic Data},
	ty = {JOUR},
	u1 = {40058{$[$}PII{$]$}; 12900793{$[$}pmid{$]$}},
	url = {http://www.ncbi.nlm.nih.gov/pmc/articles/PMC1180677/},
	volume = {73},
	year = {2003},
	year1 = {2003/07/29},
