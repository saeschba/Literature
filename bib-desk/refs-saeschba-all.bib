	number = {5},
	pages = {1162--1169},
	title = {A Comparison of Bayesian Methods for Haplotype Reconstruction from Population Genotype Data},
	ty = {JOUR},
	url = {http://www.sciencedirect.com/science/article/B8JDD-4RBW517-M/1/56c84360a3c6f2790ac76a51d7c75069},
