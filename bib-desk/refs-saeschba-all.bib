	journal_long = {American Journal of Human Genetics},
	keywords = {Armenian highlands; Armenians; Balkan theory; Bronze Age; genetic continuity; whole-genome study},
	mesh = {Humans; Armenia; Genetic Variation; Genetics, Population; Genome, Human; Demography},
	month = {Jan},
	monthly-rev = {0},
	monthly-review = {1},
	number = {1},
