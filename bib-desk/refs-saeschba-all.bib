	year = {2024},
	bdsk-url-1 = {https://doi.org/10.1016/j.ajhg.2024.06.003}}

@article{Thorpe:2024aa,
	abstract = {There is mounting evidence of the value of clinical genome sequencing (cGS) in individuals with suspected rare genetic disease (RGD), but cGS performance and impact on clinical care in a diverse population drawn from both high-income countries (HICs) and low- and middle-income countries (LMICs) has not been investigated. The iHope program, a philanthropic cGS initiative, established a network of 24 clinical sites in eight countries through which it provided cGS to individuals with signs or symptoms of an RGD and constrained access to molecular testing. A total of 1,004 individuals (median age, 6.5 years; 53.5% male) with diverse ancestral backgrounds (51.8% non-majority European) were assessed from June 2016 to September 2021. The diagnostic yield of cGS was 41.4% (416/1,004), with individuals from LMIC sites 1.7 times more likely to receive a positive test result compared to HIC sites (LMIC 56.5% [195/345] vs. HIC 33.5% [221/659], OR 2.6, 95% CI 1.9-3.4, p < 0.0001). A change in diagnostic evaluation occurred in 76.9% (514/668) of individuals. Change of management, inclusive of specialty referrals, imaging and testing, therapeutic interventions, and palliative care, was reported in 41.4% (285/694) of individuals, which increased to 69.2% (480/694) when genetic counseling and avoidance of additional testing were also included. Individuals from LMIC sites were as likely as their HIC counterparts to experience a change in diagnostic evaluation (OR 6.1, 95% CI 1.1-∞, p = 0.05) and change of management (OR 0.9, 95% CI 0.5-1.3, p = 0.49). Increased access to genomic testing may support diagnostic equity and the reduction of global health care disparities.},
	author = {Thorpe, Erin and Williams, Taylor and Shaw, Chad and Chekalin, Evgenii and Ortega, Julia and Robinson, Keisha and Button, Jason and Jones, Marilyn C and Campo, Miguel Del and Basel, Donald and McCarrier, Julie and Keppen, Laura Davis and Royer, Erin and Foster-Bonds, Romina and Duenas-Roque, Milagros M and Urraca, Nora and Bosfield, Kerri and Brown, Chester W and Lydigsen, Holly and Mroczkowski, Henry J and Ward, Jewell and Sirchia, Fabio and Giorgio, Elisa and Vaux, Keith and Salguero, Hildegard Pe{\~n}a and Lumaka, Aim{\'e} and Mubungu, Gerrye and Makay, Prince and Ngole, Mamy and Lukusa, Prosper Tshilobo and Vanderver, Adeline and Muirhead, Kayla and Sherbini, Omar and Lah, Melissa D and Anderson, Katelynn and Bazalar-Montoya, Jeny and Rodriguez, Richard S and Cornejo-Olivas, Mario and Milla-Neyra, Karina and Shinawi, Marwan and Magoulas, Pilar and Henry, Duncan and Gibson, Kate and Wiafe, Samuel and Jayakar, Parul and Salyakina, Daria and Masser-Frye, Diane and Serize, Arturo and Perez, Jorge E and Taylor, Alan and Shenbagam, Shruti and Abou Tayoun, Ahmad and Malhotra, Alka and Bennett, Maren and Rajan, Vani and Avecilla, James and Warren, Andrew and Arseneault, Max and Kalista, Tasha and Crawford, Ali and Ajay, Subramanian S and Perry, Denise L and Belmont, John and Taft, Ryan J},
	date-added = {2024-07-15 08:30:23 +0200},
