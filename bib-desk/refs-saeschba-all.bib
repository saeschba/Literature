@article{Galbraith:2024aa,
	abstract = {Global polls have shown that people in high-income countries generally report being more satisfied with their lives than people in low-income countries. The persistence of this correlation, and its similarity to correlations between income and life satisfaction within countries, could lead to the impression that high levels of life satisfaction can only be achieved in wealthy societies. However, global polls have typically overlooked small-scale, nonindustrialized societies, which can provide an alternative test of the consistency of this relationship. Here, we present results from a survey of 2,966 members of Indigenous Peoples and local communities among 19 globally distributed sites. We find that high average levels of life satisfaction, comparable to those of wealthy countries, are reported for numerous populations that have very low monetary incomes. Our results are consistent with the notion that human societies can support very satisfying lives for their members without necessarily requiring high degrees of monetary wealth.},
	author = {Galbraith, Eric D and Barrington-Leigh, Christopher and Mi{\~n}arro, Sara and {\'A}lvarez-Fern{\'a}ndez, Santiago and Attoh, Emmanuel M N A N and Benyei, Petra and Calvet-Mir, Laura and Carmona, Rosario and Chakauya, Rumbidzayi and Chen, Zhuo and Chengula, Fasco and Fern{\'a}ndez-Llamazares, {\'A}lvaro and Garc{\'\i}a-Del-Amo, David and Glauser, Marcos and Huanca, Tomas and Izquierdo, Andrea E and Junqueira, Andr{\'e} B and Lanker, Marisa and Li, Xiaoyue and Mariel, Juliette and Miara, Mohamed D and Porcher, Vincent and Porcuna-Ferrer, Anna and Schlingmann, Anna and Seidler, Reinmar and Shrestha, Uttam Babu and Singh, Priyatma and Torrents-Tic{\'o}, Miquel and Ulambayar, Tungalag and Wu, Rihan and Reyes-Garc{\'\i}a, Victoria},
	date-added = {2024-03-03 10:01:02 +0100},
	date-modified = {2024-03-03 10:01:23 +0100},
	doi = {10.1073/pnas.2311703121},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {Indigenous Peoples; happiness; monetary income; subjective well-being; wealth},
	mesh = {Humans; Income; Personal Satisfaction; Poverty; Societies; Social Problems},
	month = {Feb},
	monthly-rev = {1},
	number = {7},
