	journal_long = {Zeitschrift f{\"u}r Zellforschung und Mikroskopische Anatomie},
	keywords = {Dobzhansky--Muller incompatibilities, male sterility, Drosophila pseudoobscura},
	number = {2},
	pages = {169--223},
	title = {Studies on hybrid sterility: I. {Spermatogenesis in pure and hybrid \emph{Drosophila pseudoobscura}}},
	url = {http://dx.doi.org/10.1007/BF00374056},
