	pmc = {PMC11228492},
	pmid = {38913905},
	pst = {ppublish},
	title = {Genomic structural variation contributes to evolved changes in gene expression in high-altitude Tibetan sheep},
	url = {https://doi.org/10.1073/pnas.2322291121},
