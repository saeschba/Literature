	keywords = {shotgun library construction, NGS library preparation, adaptor incorporation, sub-nanogram library conxtruction},
	mesh = {Animals; DNA; DNA Fragmentation; Drosophila; Escherichia coli; Exons; Genome, Human; Genome, Insect; Genomic Library; Humans; Polymerase Chain Reaction; Sequence Analysis, DNA; Transposases},
