	date-modified = {2016-06-28 19:39:09 +0000},
	day = {04},
	journal = NatCommun,
	journal_long = {Nature Communications},
	keywords = {GWAS, food crops, rice, open-access research platform, germplasm collection, SNP dataset, gene discovery, bioinformatics resources, grain length},
	l3 = {10.1038/ncomms10532},
	m3 = {Article},
	month = {02},
	publisher = {Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved.},
	title = {Open access resources for genome-wide association mapping in rice},
	ty = {JOUR},
