	journal_long = {American Journal of Human Genetics},
	keywords = {Neanderthal; UK Biobank; introgression phenotype},
	mesh = {Animals; Biological Evolution; Cohort Studies; European Continental Ancestry Group; Gene Frequency; Genome, Human; Hair Color; Haplotypes; Humans; Linkage Disequilibrium; Neanderthals; Phenotype; Phylogeny; Polymorphism, Single Nucleotide; Skin Pigmentation},
	month = {Oct},
