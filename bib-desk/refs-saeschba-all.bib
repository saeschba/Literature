	doi = {10.1093/dnares/dst033},
	journal = DNARes,
	journal-full = {DNA research : an international journal for rapid publication of reports on genes and genomes},
	journal_long = {DNA Research},
	keywords = {genome-wide association studies; linkage disequilibrium; single nucleotide polymorphism; tomato; whole-genome re-sequencing},
	mesh = {Crops, Agricultural; Genetic Loci; Genetic Markers; Genome, Plant; Genome-Wide Association Study; Genotype; Linkage Disequilibrium; Lycopersicon esculentum; Polymorphism, Single Nucleotide; Sequence Analysis, DNA},
	month = {Dec},
	number = {6},
	pages = {593--603},
	pmc = {PMC3859326},
	pmid = {23903436},
	pst = {ppublish},
