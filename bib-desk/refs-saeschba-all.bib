	journal = TrendsPlantSci,
	journal-full = {Trends in plant science},
	journal_long = {Trends in Plant Science},
	keywords = {continuous light, circadian clock, light-signalling pathway, continuous light tolerance, Solanum, photosynthesis, photoperiod},
	mesh = {Carbon; Carbon Dioxide; Circadian Clocks; Circadian Rhythm; Ethylenes; Light; Lycopersicon esculentum; Oxidative Stress; Photoperiod; Photosynthesis; Plant Leaves; Plants; Reactive Oxygen Species; Signal Transduction},
	month = {Jun},
	number = {6},
	pages = {310--318},
	pmid = {21396878},
	pst = {ppublish},
	title = {Plants under continuous light},
	volume = {16},
