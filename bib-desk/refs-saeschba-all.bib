@article{Eshel:1984qf,
	abstract = {The estimated survival probability of a slightly supercritical Galton-Watson process is generalized to a multitype branching process. The result is used to estimate the probability of initial success of a mutant gene whose effect on the individual carrier depends on the carrier's sex, class, etc. The probability of initial success is also estimated in a case where the effect of the mutation is manifested in terms of the distribution of types within one's progeny, e.g. in a case of a change in the sex ratio.},
