	journal_long = {Annals of Anatomy},
	keywords = {ancient DNA, laboratory equipment, technology},
	mesh = {Animals; Biological Evolution; DNA; Humans; Laboratories; Paleontology; Plants; Polymerase Chain Reaction; Sequence Analysis, DNA; Specimen Handling},
	month = {Jan},
