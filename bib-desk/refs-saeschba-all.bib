	keywords = {functional traits; invasive plants; invasive species impacts community-weighted mean traits},
	mesh = {Ecosystem; Plants; Introduced Species; United States; Forests; Biodiversity; Plant Physiological Phenomena; Plant Roots},
	month = {Oct},
	monthly-review = {1},
	number = {40},
	pages = {e2403120121},
	pmid = {39298470},
	pst = {ppublish},
	title = {Naturalized species drive functional trait shifts in plant communities},
