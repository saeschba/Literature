@article{Kimmig:2024aa,
	abstract = {Fossil-Lagerst{\"a}tten are amongst the most important windows onto the paleobiology of ancient ecosystems. Inconsistencies surrounding what constitutes a Lagerst{\"a}tte limits our ability to compare sites and thus their scientific potential. Here, we provide a modern and utilitarian classification scheme for Konservat-Lagerst{\"a}tten, allowing for more consistent and improved scientific discourse.},
