	journal_long = {Nature Communications},
	keywords = {Solanum, photoperiod, day light, artificial light, continuous light tolerance, CAB-13, chlorophyll a/b binding protein 13, Solanum lycopersicum, leaf chlorosis, necrosis, wild tomatoes, Solanum pimpinellifolium, Solanum neorickii, Solanum habrochaites, Solanum pennellii, Solanum peruvianum},
	l3 = {10.1038/ncomms5549; https://www.nature.com/articles/ncomms5549#supplementary-information},
	m3 = {Article},
	month = {08},
	pages = {4549 EP},
	publisher = {Nature Publishing Group, a division of Macmillan Publishers Limited. All Rights Reserved. SN -},
	title = {A single locus confers tolerance to continuous light and allows substantial yield increase in tomato},
