	keywords = {genetic basis; hybrid zone; seasonal migration; songbirds; speciation},
	mesh = {Animals; Animal Migration; Seasons; Songbirds; Genetic Speciation; Hybridization, Genetic; Receptors, Cholinergic; Genomics; Chromosome Mapping},
	month = {Apr},
