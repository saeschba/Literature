	doi = {10.1073/pnas.2313921121},
	journal = ProcNatlAcadSciUSA,
	journal-full = {Proceedings of the National Academy of Sciences of the United States of America},
	journal_long = {Proceedings of the National Academy of Sciences of the United States of America},
	keywords = {allopolyploidy; chromosomal fusion; genome duplications; karyotype evolution; protochromosome},
	mesh = {Genome, Plant; Gossypium; Genomics; Polyploidy; Karyotype; Evolution, Molecular},
	month = {Apr},
	monthly-rev = {1},
	number = {15},
	pages = {e2313921121},
	pmid = {38568968},
	pst = {ppublish},
	title = {Subgenome-aware analyses reveal the genomic consequences of ancient allopolyploid hybridizations throughout the cotton family},
	url = {https://doi.org/10.1073/pnas.2313921121},
	volume = {121},
