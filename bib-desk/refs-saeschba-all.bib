	keywords = {Neanderthal, Mezmaiskaya cave},
	number = {1},
	pages = {77--86},
	publisher = {{$[$}The University of Chicago Press, Wenner-Gren Foundation for Anthropological Research{$]$}},
	title = {Mezmaiskaya Cave: A {Neanderthal} Occupation in the {Northern Caucasus}},
	ty = {JOUR},
	url = {http://www.jstor.org/stable/10.1086/515805},
