	journal = Heredity,
	keywords = {F-statistics, population subdivision, migration, migration rate, gene flow, estimators},
	pages = {117--125},
	part-number = {2},
	publication-type = {J},
	times-cited = {464},
	title = {{Indirect measures of gene flow and migration: $F_{\textrm{ST}}$ not equal $1/(4Nm+1)$}},
	volume = {82},
