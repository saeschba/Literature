	pmid = {11097923},
	pst = {ppublish},
	title = {Chemoraces and habitat specialization of \emph{{Claviceps purpurea}} populations},
	url = {https://doi.org/10.1128/AEM.66.12.5419-5425.2000},
	volume = {66},
	year = {2000},
