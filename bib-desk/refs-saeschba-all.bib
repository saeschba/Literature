@article{Klug:2022aa,
	abstract = {Understanding the benefits and costs of recombination under different scenarios of evolutionary adaptation remains an open problem for theoretical and experimental research. In this study, we focus on finite populations evolving on neutral networks comprising viable and unfit genotypes. We provide a comprehensive overview of the effects of recombination by jointly considering different measures of evolvability and mutational robustness over a broad parameter range, such that many evolutionary regimes are covered. We find that several of these measures vary non-monotonically with the rates of mutation and recombination. Moreover, the presence of unfit genotypes that introduce inhomogeneities in the network of viable states qualitatively alters the effects of recombination. We conclude that conflicting trends induced by recombination can be explained by an emerging trade-off between evolvability on the one hand, and mutational robustness on the other. Finally, we discuss how different implementations of the recombination scheme in theoretical models can affect the observed dependence on recombination rate through a coupling between recombination and genetic drift.},
	author = {Klug, Alexander and Krug, Joachim},
	date-added = {2022-12-04 21:40:06 +0100},
	date-modified = {2022-12-04 21:42:05 +0100},
	doi = {10.1371/journal.pcbi.1010710},
	journal = PLoSComputBiol,
	journal-full = {PLoS computational biology},
	journal_long = {PLoS Computational Biology},
	keywords = {recombination, evolutionary adaptation, genotype network, evolvability, mutational robustness, trade-off, genetic drift},
	month = {Nov},
	number = {11},
	pages = {e1010710},
	pmid = {36409763},
	pst = {aheadofprint},
	title = {Conflicting effects of recombination on the evolvability and robustness in neutrally evolving populations},
	volume = {18},
	year = {2022},
	bdsk-url-1 = {https://doi.org/10.1371/journal.pcbi.1010710}}

@article{Degenhardt:2022aa,
	abstract = {Given the highly variable clinical phenotype of Coronavirus disease 2019 (COVID-19), a deeper analysis of the host genetic contribution to severe COVID-19 is important to improve our understanding of underlying disease mechanisms. Here, we describe an extended genome-wide association meta-analysis of a well-characterized cohort of 3255 COVID-19 patients with respiratory failure and 12 488 population controls from Italy, Spain, Norway and Germany/Austria, including stratified analyses based on age, sex and disease severity, as well as targeted analyses of chromosome Y haplotypes, the human leukocyte antigen region and the SARS-CoV-2 peptidome. By inversion imputation, we traced a reported association at 17q21.31 to a ~0.9-Mb inversion polymorphism that creates two highly differentiated haplotypes and characterized the potential effects of the inversion in detail. Our data, together with the 5th release of summary statistics from the COVID-19 Host Genetics Initiative including non-Caucasian individuals, also identified a new locus at 19q13.33, including NAPSA, a gene which is expressed primarily in alveolar cells responsible for gas exchange in the lung.},
	author = {Degenhardt, Frauke and Ellinghaus, David and Juzenas, Simonas and Lerga-Jaso, Jon and Wendorff, Mareike and Maya-Miles, Douglas and Uellendahl-Werth, Florian and ElAbd, Hesham and R{\"u}hlemann, Malte C and Arora, Jatin and {\"O}zer, Onur and Lenning, Ole Bernt and Myhre, Ronny and Vadla, May Sissel and Wacker, Eike M and Wienbrandt, Lars and Blandino Ortiz, Aaron and de Salazar, Adolfo and Garrido Chercoles, Adolfo and Palom, Adriana and Ruiz, Agust{\'\i}n and Garcia-Fernandez, Alba-Estela and Blanco-Grau, Albert and Mantovani, Alberto and Zanella, Alberto and Holten, Aleksander Rygh and Mayer, Alena and Bandera, Alessandra and Cherubini, Alessandro and Protti, Alessandro and Aghemo, Alessio and Gerussi, Alessio and Ramirez, Alfredo and Braun, Alice and Nebel, Almut and Barreira, Ana and Lleo, Ana and Teles, Ana and Kildal, Anders Benjamin and Biondi, Andrea and Caballero-Garralda, Andrea and Ganna, Andrea and Gori, Andrea and Gl{\"u}ck, Andreas and Lind, Andreas and Tanck, Anja and Hinney, Anke and Carreras Nolla, Anna and Fracanzani, Anna Ludovica and Peschuck, Anna and Cavallero, Annalisa and Dyrhol-Riise, Anne Ma and Ruello, Antonella and Juli{\`a}, Antonio and Muscatello, Antonio and Pesenti, Antonio and Voza, Antonio and Rando-Segura, Ariadna and Solier, Aurora and Schmidt, Axel and Cortes, Beatriz and Mateos, Beatriz and Nafria-Jimenez, Beatriz and Schaefer, Benedikt and Jensen, Bj{\"o}rn and Bellinghausen, Carla and Maj, Carlo and Ferrando, Carlos and de la Horra, Carmen and Quereda, Carmen and Skurk, Carsten and Thibeault, Charlotte and Scollo, Chiara and Herr, Christian and Spinner, Christoph D and Gassner, Christoph and Lange, Christoph and Hu, Cinzia and Paccapelo, Cinzia and Lehmann, Clara and Angelini, Claudio and Cappadona, Claudio and Azuure, Clinton and {COVICAT study group, Aachen Study (COVAS)} and Bianco, Cristiana and Cea, Cristina and Sancho, Cristina and Hoff, Dag Arne Lihaug and Galimberti, Daniela and Prati, Daniele and Haschka, 