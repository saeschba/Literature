@article{Fairbanks:2016aa,
	abstract = {Gregor Mendel{\textquoteright}s classic paper, Versuche {\"u}ber Pflanzen-Hybriden (Experiments on Plant Hybrids), was published in 1866, hence 2016 is its sesquicentennial. Mendel completed his experiments in 1863 and shortly thereafter began compiling the results and writing his paper, which he presented in meetings of the Natural Science Society in Br{\"u}nn in February and March of 1865. Mendel owned a personal copy of Darwin{\textquoteright}s Origin of Species, a German translation published in 1863, and it contains his marginalia. Its publication date indicates that Mendel{\textquoteright}s study of Darwin{\textquoteright}s book could have had no influence while he was conducting his experiments but its publication date coincided with the period of time when he was preparing his paper, making it possible that Darwin{\textquoteright}s writings influenced Mendel{\textquoteright}s interpretations and theory. Based on this premise, we prepared a Darwinized English translation of Mendel{\textquoteright}s paper by comparing German terms Mendel employed with the same terms in the German translation of Origin of Species in his possession, then using Darwin{\textquoteright}s counterpart English words and phrases as much as possible in our translation. We found a substantially higher use of these terms in the final two (10th and 11th) sections of Mendel{\textquoteright}s paper, particularly in one key paragraph, where Mendel reflects on evolutionary issues, providing strong evidence of Darwin{\textquoteright}s influence on Mendel.},
	author = {Fairbanks, Daniel J. and Abbott, Scott},
	date-added = {2016-10-14 05:51:11 +0000},
	date-modified = {2016-10-14 05:51:57 +0000},
	doi = {10.1534/genetics.116.194613},
	eprint = {http://www.genetics.org/content/204/2/401.full.pdf},
	issn = {0016-6731},
	journal = Genetics,
	journal_long = {Genetics},
	keywords = {Mendel, Darwin, communication},
	number = {2},
	pages = {401--405},
	publisher = {Genetics},
	title = {{Darwin}'s Influence on {Mendel}: Evidence from a New Translation of {Mendel}s Paper},
	url = {http://www.genetics.org/content/204/2/401},
	volume = {204},
	year = {2016},
	bdsk-url-1 = {http://www.genetics.org/content/204/2/401},
	bdsk-url-2 = {http://dx.doi.org/10.1534/genetics.116.194613}}

